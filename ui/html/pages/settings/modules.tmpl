{{define "title"}}Manage Modules{{end}}

{{define "header"}}Manage Modules{{end}}
{{define "subheader"}}Install or uninstall application features{{end}}

{{define "main"}}
<div class="row">
    <div class="col-md-12 tw-mb-4" style="margin-bottom: 20px;">
        <form action="/settings/modules" method="POST" class="pull-right">
            <input type="hidden" name="action" value="install_all">
            <button type="submit" class="btn btn-primary">
                <i class="fa fa-layer-group"></i> Install All Modules
            </button>
        </form>
    </div>
</div>

<div class="row">
    {{range .PageData.Modules}}
    <div class="col-md-4">
        <div class="box box-{{if .IsInstalled}}success{{else}}default{{end}}">
            <div class="box-header with-border">
                <h3 class="box-title">{{.Name}}</h3>
                <div class="box-tools pull-right">
                    {{if .IsInstalled}}
                    <span class="label label-success">Installed</span>
                    {{else}}
                    <span class="label label-default">Not Installed</span>
                    {{end}}
                </div>
            </div>
            <div class="box-body">
                <p>Manage {{.Name}} functionality for your business.</p>
                
                {{if .IsInstalled}}
                <form action="/settings/modules" method="POST" onsubmit="return confirm('Are you sure you want to uninstall this module?');">
                    <input type="hidden" name="module_key" value="{{.Key}}">
                    <input type="hidden" name="action" value="uninstall">
                    
                    <div class="form-group">
                        <div class="checkbox">
                            <label>
                                <input type="checkbox" name="clear_data" value="1"> 
                                <span class="text-danger">Clear all data associated with this module</span>
                            </label>
                        </div>
                    </div>
                    
                    <button type="submit" class="btn btn-danger btn-block">
                        <i class="fa fa-trash"></i> Uninstall Module
                    </button>
                </form>
                {{else}}
                <form action="/settings/modules" method="POST">
                    <input type="hidden" name="module_key" value="{{.Key}}">
                    <input type="hidden" name="action" value="install">
                    <button type="submit" class="btn btn-success btn-block">
                        <i class="fa fa-download"></i> Install Module
                    </button>
                </form>
                {{if eq .Key "sales"}}
                <p class="text-muted small tw-mt-2">Note: Basic sales features will be added to your dashboard.</p>
                {{end}}
                {{end}}
            </div>
        </div>
    </div>
    {{end}}
</div>

<div class="row">
    <div class="col-md-12">
        <div class="callout callout-info">
            <h4><i class="fa fa-info-circle"></i> Module Management</h4>
            <p>Modules allow you to customize your experience by only showing the features you need. Uninstalled modules will be hidden from the navigation sidebar. You can choose to keep your data or clear it during uninstallation.</p>
        </div>
    </div>
</div>
{{end}}
