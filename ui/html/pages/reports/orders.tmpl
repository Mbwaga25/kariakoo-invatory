{{define "title"}}Orders Report & Ledger{{end}}

{{define "header"}}Orders Report & Ledger{{end}}
{{define "subheader"}}Detailed overview of orders and customer credit/payment status{{end}}

{{define "main"}}
<div class="row" style="margin-bottom: 20px;">
    <div class="col-md-12">
        <div class="box box-primary">
            <div class="box-body">
                <form method="GET" action="/reports/orders" class="form-inline">
                    <div class="form-group" style="margin-right: 15px;">
                        <label style="margin-right: 5px;">Start Date:</label>
                        <input type="date" name="start_date" class="form-control" value="{{.PageData.Start.Format "2006-01-02"}}">
                    </div>
                    <div class="form-group" style="margin-right: 15px;">
                        <label style="margin-right: 5px;">End Date:</label>
                        <input type="date" name="end_date" class="form-control" value="{{.PageData.End.Format "2006-01-02"}}">
                    </div>
                    <div class="form-group" style="margin-right: 15px;">
                        <label style="margin-right: 5px;">Payment Status:</label>
                        <select name="payment_status" class="form-control" style="min-width: 140px;">
                            <option value="">-- All Payments --</option>
                            <option value="paid" {{if eq .PageData.PaymentStatus "paid"}}selected{{end}}>Fully Paid</option>
                            <option value="incomplete" {{if eq .PageData.PaymentStatus "incomplete"}}selected{{end}}>Partially Paid</option>
                            <option value="unpaid" {{if eq .PageData.PaymentStatus "unpaid"}}selected{{end}}>Unpaid</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary"><i class="fa fa-filter"></i> Filter</button>
                    <a href="/reports/orders" class="btn btn-default" style="margin-left: 5px;">Reset</a>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Summary Cards -->
<div class="row">
    <!-- Total Orders -->
    <div class="col-lg-3 col-xs-6">
        <div class="small-box bg-aqua" style="border-radius: 8px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
            <div class="inner" style="padding: 15px 20px;">
                <h3>{{.PageData.Report.Summary.TotalOrders}}</h3>
                <p style="font-weight: 600;">Total Orders</p>
                <h4 style="margin: 5px 0 0 0; font-size: 16px;">{{.CurrencySymbol}} {{printf "%.2f" .PageData.Report.Summary.TotalAmount}}</h4>
            </div>
            <div class="icon">
                <i class="fa fa-shopping-bag"></i>
            </div>
        </div>
    </div>
    
    <!-- Paid Full -->
    <div class="col-lg-3 col-xs-6">
        <div class="small-box bg-green" style="border-radius: 8px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
            <div class="inner" style="padding: 15px 20px;">
                <h3>{{.PageData.Report.Summary.PaidFullCount}}</h3>
                <p style="font-weight: 600;">Fully Paid</p>
                <h4 style="margin: 5px 0 0 0; font-size: 16px;">{{.CurrencySymbol}} {{printf "%.2f" .PageData.Report.Summary.TotalPaid}}</h4>
            </div>
            <div class="icon">
                <i class="fa fa-check-circle"></i>
            </div>
        </div>
    </div>

    <!-- Paid Partial -->
    <div class="col-lg-3 col-xs-6">
        <div class="small-box bg-yellow" style="border-radius: 8px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
            <div class="inner" style="padding: 15px 20px;">
                <h3>{{.PageData.Report.Summary.PaidPartialCount}}</h3>
                <p style="font-weight: 600;">Partially Paid</p>
                <h4 style="margin: 5px 0 0 0; font-size: 16px;">{{.CurrencySymbol}} {{printf "%.2f" (subtract .PageData.Report.Summary.TotalAmount (add .PageData.Report.Summary.TotalPaid .PageData.Report.Summary.TotalRemaining))}}</h4>
            </div>
            <div class="icon">
                <i class="fa fa-hourglass-half"></i>
            </div>
        </div>
    </div>

    <!-- Pending / Unpaid Balance -->
    <div class="col-lg-3 col-xs-6">
        <div class="small-box bg-red" style="border-radius: 8px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
            <div class="inner" style="padding: 15px 20px;">
                <h3>{{.PageData.Report.Summary.PendingCount}}</h3>
                <p style="font-weight: 600;">Unpaid Orders</p>
                <h4 style="margin: 5px 0 0 0; font-size: 16px;">{{.CurrencySymbol}} {{printf "%.2f" .PageData.Report.Summary.TotalRemaining}}</h4>
            </div>
            <div class="icon">
                <i class="fa fa-exclamation-triangle"></i>
            </div>
        </div>
    </div>
</div>

<!-- Customer Credit & Overdue Analysis Panel -->
<div class="box box-warning" style="margin-top: 15px;">
    <div class="box-header with-border">
        <h3 class="box-title" style="font-weight: 700; color: #1B2A4A;">
            <i class="fa fa-users-cog text-warning"></i> Customer Credit Risk & Overdue Analysis
        </h3>
    </div>
    <div class="box-body">
        <div class="table-responsive">
            <table class="table table-bordered table-striped datatable" style="width:100%">
                <thead>
                    <tr style="background: #f8fafc; color: #1B2A4A;">
                        <th>Customer Name</th>
                        <th style="text-align: right;">Credit Limit</th>
                        <th style="text-align: right;">Outstanding Debt (All Time)</th>
                        <th>Credit Limit Status</th>
                        <th style="text-align: center;">Due Days Limit</th>
                        <th style="text-align: center;">Oldest Unpaid Invoice</th>
                        <th>Overdue Status</th>
                        <th style="text-align: right;">Range Total Bought</th>
                        <th style="text-align: right;">Range Total Paid</th>
                    </tr>
                </thead>
                <tbody>
                    {{range .PageData.Report.Customers}}
                    <tr>
                        <td><strong>{{.CustomerName}}</strong></td>
                        <td style="text-align: right; font-weight: 600;">
                            {{if gt .CreditLimit 0.0}}
                            {{$.CurrencySymbol}} {{printf "%.2f" .CreditLimit}}
                            {{else}}
                            <span class="text-muted" style="font-size:12px;">No Limit</span>
                            {{end}}
                        </td>
                        <td style="text-align: right; font-weight: 600; color: #d32f2f;">
                            {{$.CurrencySymbol}} {{printf "%.2f" .TotalDebt}}
                        </td>
                        <td>
                            {{if .LimitExceeded}}
                            <span class="label label-danger" style="font-size: 11px; padding: 3px 8px; font-weight: bold;"><i class="fa fa-ban"></i> EXCEEDED</span>
                            {{else if gt .CreditLimit 0.0}}
                            <span class="label label-success" style="font-size: 11px; padding: 3px 8px;"><i class="fa fa-check"></i> Safe</span>
                            {{else}}
                            <span class="label label-default" style="font-size: 11px; padding: 3px 8px;">Unlimited</span>
                            {{end}}
                        </td>
                        <td style="text-align: center; font-weight: 600;">
                            {{if gt .InvoiceDueDays 0}}
                            {{.InvoiceDueDays}} Days
                            {{else}}
                            <span class="text-muted" style="font-size:12px;">No Limit</span>
                            {{end}}
                        </td>
                        <td style="text-align: center; font-weight: 600; color: {{if .Overdue}}#d32f2f{{else}}#555{{end}};">
                            {{if gt .OldestUnpaidDays 0}}
                            {{.OldestUnpaidDays}} Days Ago
                            {{else}}
                            <span class="text-muted" style="font-size:12px;">N/A (All Paid)</span>
                            {{end}}
                        </td>
                        <td>
                            {{if .Overdue}}
                            <span class="label label-danger" style="font-size: 11px; padding: 3px 8px; font-weight: bold;"><i class="fa fa-clock"></i> OVERDUE</span>
                            {{else if gt .OldestUnpaidDays 0}}
                            <span class="label label-success" style="font-size: 11px; padding: 3px 8px;"><i class="fa fa-check"></i> Safe</span>
                            {{else}}
                            <span class="label label-default" style="font-size: 11px; padding: 3px 8px;">No Debt</span>
                            {{end}}
                        </td>
                        <td style="text-align: right; font-weight: 600; color: #1B2A4A;">
                            {{$.CurrencySymbol}} {{printf "%.2f" .RangeTotal}}
                        </td>
                        <td style="text-align: right; font-weight: 600; color: #2e7d32;">
                            {{$.CurrencySymbol}} {{printf "%.2f" .RangePaid}}
                        </td>
                    </tr>
                    {{end}}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Orders Ledger list of the range -->
<div class="box box-primary" style="margin-top: 20px;">
    <div class="box-header with-border">
        <h3 class="box-title" style="font-weight: 700; color: #1B2A4A;"><i class="fa fa-receipt text-primary"></i> Orders Placed in this Period</h3>
    </div>
    <div class="box-body">
        <div class="table-responsive">
            <table class="table table-bordered table-striped datatable" style="width:100%">
                <thead>
                    <tr style="background: #f8fafc; color: #1B2A4A;">
                        <th>Date</th>
                        <th>Order Ref</th>
                        <th>Customer / Location</th>
                        <th>Type</th>
                        <th style="text-align: right;">Total Amount</th>
                        <th style="text-align: right;">Paid To Date</th>
                        <th style="text-align: right;">Remaining Balance</th>
                        <th>Payment Status</th>
                        <th>Order Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    {{range .PageData.Report.Orders}}
                    <tr>
                        <td>{{.CreatedAt.Format "Jan 02, 2006 15:04"}}</td>
                        <td><strong>{{.RefNo}}</strong></td>
                        <td>
                            {{if .OrderFrom}}
                            <span class="text-primary"><i class="fa fa-user"></i> {{.OrderFrom}}</span>
                            {{else}}
                            <span class="text-success"><i class="fa fa-building"></i> {{.ToLocationName}}</span>
                            {{end}}
                        </td>
                        <td>
                            {{if eq .OrderType "StoreOrder"}}
                            <span class="label label-success">Store Transfer</span>
                            {{else}}
                            <span class="label label-info">Bulk Sale</span>
                            {{end}}
                        </td>
                        <td style="text-align: right; font-weight: 600;">{{$.CurrencySymbol}} {{printf "%.2f" .TotalAmount}}</td>
                        <td style="text-align: right; font-weight: 600; color: #2e7d32;">{{$.CurrencySymbol}} {{printf "%.2f" .AmountPaid}}</td>
                        <td style="text-align: right; font-weight: 600; color: {{if gt .RemainingAmount 0.0}}#d32f2f{{else}}#555{{end}};">{{$.CurrencySymbol}} {{printf "%.2f" .RemainingAmount}}</td>
                        <td>
                            {{if eq .PaymentStatus "paid"}}
                            <span class="label label-success" style="font-size: 11px;">Fully Paid</span>
                            {{else if eq .PaymentStatus "incomplete"}}
                            <span class="label label-warning" style="font-size: 11px;">Partially Paid</span>
                            {{else}}
                            <span class="label label-danger" style="font-size: 11px;">Unpaid</span>
                            {{end}}
                        </td>
                        <td>
                            <span class="label label-{{.Status}}" style="font-size: 11px; padding: 2px 6px;">{{.Status}}</span>
                        </td>
                        <td>
                            <a href="/orders/invoice?id={{.ID}}" class="btn btn-xs btn-default" target="_blank"><i class="fa fa-eye"></i> Invoice</a>
                        </td>
                    {{end}}
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    if ($.fn.DataTable && !$.fn.DataTable.isDataTable('.datatable')) {
        $('.datatable').DataTable({
            responsive: true,
            dom: 'Bfrtip',
            buttons: ['copy', 'csv', 'excel', 'pdf', 'print']
        });
    }
});
</script>
{{end}}
