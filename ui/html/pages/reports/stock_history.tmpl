{{define "title"}}Stock History{{end}}

{{define "header"}}Stock History Ledger{{end}}
{{define "subheader"}}Detailed log of all stock movements (Restocks, Sales, Transfers){{end}}

{{define "main"}}
<!-- Date Filter -->
<div class="row">
    <div class="col-md-12">
        <div class="box box-primary">
            <div class="box-body">
                <form action="/reports/stock-history" method="GET" class="form-inline">
                    <div class="form-group">
                        <label>From: </label>
                        <input type="date" name="start_date" class="form-control" value="{{.PageData.Start.Format "2006-01-02"}}">
                    </div>
                    <div class="form-group tw-ml-2">
                        <label>To: </label>
                        <input type="date" name="end_date" class="form-control" value="{{.PageData.End.Format "2006-01-02"}}">
                    </div>
                    <button type="submit" class="btn btn-primary tw-ml-2"><i class="fa fa-filter"></i> Filter</button>
                    <a href="/reports/stock-history" class="btn btn-default tw-ml-2">Today</a>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="box box-primary">
    <div class="box-header with-border" style="background:#1B2A4A;color:#fff;">
        <h3 class="box-title" style="color:#fff;"><i class="fa fa-history"></i> Stock Movement Ledger</h3>
        <div class="box-tools pull-right">
            <button type="button" class="btn btn-box-tool" onclick="window.print()" style="color:#fff;"><i class="fa fa-print"></i> Print</button>
        </div>
    </div>
    <div class="box-body">
        <div class="table-responsive">
            <table class="table table-bordered table-striped datatable">
                <thead>
                    <tr style="background:#F0F4F8;">
                        <th>Date & Time</th>
                        <th>Product</th>
                        <th>Location</th>
                        <th>Type</th>
                        <th>Ref / Invoice</th>
                        <th class="text-center">Quantity</th>
                        <th class="text-center">Flow</th>
                    </tr>
                </thead>
                <tbody>
                    {{range .PageData.Movements}}
                    <tr>
                        <td>{{.Date.Format "Jan 02, 2006 15:04"}}</td>
                        <td><strong>{{.ProductName}}</strong></td>
                        <td>{{.LocationName}}</td>
                        <td>
                            {{if eq .Type "Purchase"}}
                            <span class="label label-success"><i class="fa fa-download"></i> RESTOCK</span>
                            {{else if eq .Type "Sale"}}
                            <span class="label label-danger"><i class="fa fa-shopping-cart"></i> SALE</span>
                            {{else}}
                            <span class="label label-info"><i class="fa fa-exchange-alt"></i> TRANSFER</span>
                            {{end}}
                            <small class="text-muted" style="display:block;">{{.Type}}</small>
                        </td>
                        <td><code>{{.RefNo}}</code></td>
                        <td class="text-center">
                            <span style="font-size:15px;font-weight:bold;">{{printf "%.0f" .Quantity}}</span>
                        </td>
                        <td class="text-center">
                            {{if eq .Flow "IN"}}
                            <span class="badge" style="background:#2E7D32;padding:5px 12px;"><i class="fa fa-arrow-up"></i> IN</span>
                            {{else}}
                            <span class="badge" style="background:#C62828;padding:5px 12px;"><i class="fa fa-arrow-down"></i> OUT</span>
                            {{end}}
                        </td>
                    </tr>
                    {{else}}
                    <tr><td colspan="7" class="text-center">No stock movements found for this period</td></tr>
                    {{end}}
                </tbody>
            </table>
        </div>
    </div>
</div>
{{end}}
