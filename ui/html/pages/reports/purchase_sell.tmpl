{{define "title"}}Purchase & Sell Report{{end}}

{{define "header"}}Purchase & Sell Report{{end}}
{{define "subheader"}}Summary of purchases and sales ({{.PageData.Start.Format "Jan 02, 2006"}} - {{.PageData.End.Format "Jan 02, 2006"}}){{end}}

{{define "main"}}
<!-- Date Filter -->
<div class="row">
    <div class="col-md-12">
        <div class="box box-primary">
            <div class="box-body">
                <form action="/reports/purchase-sell" method="GET" class="form-inline">
                    <div class="form-group">
                        <label>From: </label>
                        <input type="date" name="start_date" class="form-control" value="{{.PageData.Start.Format "2006-01-02"}}">
                    </div>
                    <div class="form-group tw-ml-2">
                        <label>To: </label>
                        <input type="date" name="end_date" class="form-control" value="{{.PageData.End.Format "2006-01-02"}}">
                    </div>
                    <button type="submit" class="btn btn-primary tw-ml-2"><i class="fa fa-filter"></i> Filter</button>
                    <a href="/reports/purchase-sell" class="btn btn-default tw-ml-2">Today</a>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6 col-sm-12">
        <div class="box box-info">
            <div class="box-header with-border">
                <h3 class="box-title"><i class="fa fa-shopping-basket"></i> Purchases</h3>
            </div>
            <div class="box-body">
                <table class="table table-bordered">
                    <tr>
                        <th>Total Purchase:</th>
                        <td class="text-right text-bold">{{$.CurrencySymbol}}{{printf "%.2f" .PageData.Report.TotalPurchase}}</td>
                    </tr>
                    <tr>
                        <th>Total Purchase Return:</th>
                        <td class="text-right">{{$.CurrencySymbol}}{{printf "%.2f" .PageData.Report.TotalPurchaseReturn}}</td>
                    </tr>
                    <tr class="bg-gray">
                        <th>Purchase Due:</th>
                        <td class="text-right text-red text-bold">{{$.CurrencySymbol}}{{printf "%.2f" .PageData.Report.PurchaseDue}}</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-sm-12">
        <div class="box box-success">
            <div class="box-header with-border">
                <h3 class="box-title"><i class="fa fa-shopping-cart"></i> Sales</h3>
            </div>
            <div class="box-body">
                <table class="table table-bordered">
                    <tr>
                        <th>Total Sale:</th>
                        <td class="text-right text-bold text-green">{{$.CurrencySymbol}}{{printf "%.2f" .PageData.Report.TotalSale}}</td>
                    </tr>
                    <tr>
                        <th>Total Sale Return:</th>
                        <td class="text-right">{{$.CurrencySymbol}}{{printf "%.2f" .PageData.Report.TotalSaleReturn}}</td>
                    </tr>
                    <tr class="bg-gray">
                        <th>Invoice Due:</th>
                        <td class="text-right text-red text-bold">{{$.CurrencySymbol}}{{printf "%.2f" .PageData.Report.InvoiceDue}}</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h3 class="box-title"><i class="fa fa-balance-scale"></i> Difference</h3>
            </div>
            <div class="box-body">
                <table class="table table-bordered">
                    <tr class="bg-blue">
                        <th>Net (Sales - Purchases):</th>
                        <td class="text-right text-bold">{{$.CurrencySymbol}}{{printf "%.2f" (subtract .PageData.Report.TotalSale .PageData.Report.TotalPurchase)}}</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>
</div>
{{end}}
