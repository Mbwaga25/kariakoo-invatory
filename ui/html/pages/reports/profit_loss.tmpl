{{define "title"}}Profit & Loss Report{{end}}

{{define "header"}}Profit & Loss Report{{end}}
{{define "subheader"}}Summary of revenue and expenses ({{.PageData.Start.Format "Jan 02, 2006"}} - {{.PageData.End.Format "Jan 02, 2006"}}){{end}}

{{define "main"}}
<!-- Date Filter -->
<div class="row">
    <div class="col-md-12">
        <div class="box box-primary">
            <div class="box-body">
                <form action="/reports/profit-loss" method="GET" class="form-inline">
                    <div class="form-group">
                        <label>From: </label>
                        <input type="date" name="start_date" class="form-control" value="{{.PageData.Start.Format "2006-01-02"}}">
                    </div>
                    <div class="form-group tw-ml-2">
                        <label>To: </label>
                        <input type="date" name="end_date" class="form-control" value="{{.PageData.End.Format "2006-01-02"}}">
                    </div>
                    <button type="submit" class="btn btn-primary tw-ml-2"><i class="fa fa-filter"></i> Filter</button>
                    <a href="/reports/profit-loss" class="btn btn-default tw-ml-2">Today</a>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-3 col-sm-6 col-xs-12">
        <div class="info-box bg-green">
            <span class="info-box-icon"><i class="fa fa-shopping-cart"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Total Sales</span>
                <span class="info-box-number">{{.CurrencySymbol}}{{.PageData.Report.TotalSales}}</span>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 col-xs-12">
        <div class="info-box bg-red">
            <span class="info-box-icon"><i class="fa fa-truck"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Total Purchases</span>
                <span class="info-box-number">{{.CurrencySymbol}}{{.PageData.Report.TotalPurchases}}</span>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 col-xs-12">
        <div class="info-box bg-orange">
            <span class="info-box-icon"><i class="fa fa-money"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Total Expenses</span>
                <span class="info-box-number">{{.CurrencySymbol}}{{.PageData.Report.TotalExpenses}}</span>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 col-xs-12">
        <div class="info-box bg-blue">
            <span class="info-box-icon"><i class="fa fa-calculator"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Net Profit</span>
                <span class="info-box-number">{{.CurrencySymbol}}{{.PageData.Report.NetProfit}}</span>
            </div>
        </div>
    </div>
</div>

<div class="box box-primary">
    <div class="box-header with-border">
        <h3 class="box-title">Profit & Loss Summary</h3>
    </div>
    <div class="box-body">
        <table class="table table-bordered">
            <tr>
                <td><strong>Total Revenue (Sales)</strong></td>
                <td class="text-right text-green"><strong>+ {{.CurrencySymbol}}{{.PageData.Report.TotalSales}}</strong></td>
            </tr>
            <tr>
                <td>Total Cost of Goods (Purchases)</td>
                <td class="text-right text-red">- {{.CurrencySymbol}}{{.PageData.Report.TotalPurchases}}</td>
            </tr>
            <tr class="bg-gray">
                <td><strong>Gross Profit</strong></td>
                <td class="text-right"><strong>{{.CurrencySymbol}}{{.PageData.Report.GrossProfit}}</strong></td>
            </tr>
            <tr>
                <td>Total Business Expenses</td>
                <td class="text-right text-red">- {{.CurrencySymbol}}{{.PageData.Report.TotalExpenses}}</td>
            </tr>
            <tr class="bg-blue">
                <td><strong>Net Profit</strong></td>
                <td class="text-right"><strong>{{.CurrencySymbol}}{{.PageData.Report.NetProfit}}</strong></td>
            </tr>
        </table>
    </div>
</div>
{{end}}
