{{define "title"}}Expense Report{{end}}

{{define "header"}}Expense Report{{end}}
{{define "subheader"}}Summary of expenses by category ({{.PageData.Start.Format "Jan 02, 2006"}} - {{.PageData.End.Format "Jan 02, 2006"}}){{end}}

{{define "main"}}
<!-- Date Filter -->
<div class="row">
    <div class="col-md-12">
        <div class="box box-primary">
            <div class="box-body">
                <form action="/reports/expense" method="GET" class="form-inline">
                    <div class="form-group">
                        <label>From: </label>
                        <input type="date" name="start_date" class="form-control" value="{{.PageData.Start.Format "2006-01-02"}}">
                    </div>
                    <div class="form-group tw-ml-2">
                        <label>To: </label>
                        <input type="date" name="end_date" class="form-control" value="{{.PageData.End.Format "2006-01-02"}}">
                    </div>
                    <button type="submit" class="btn btn-primary tw-ml-2"><i class="fa fa-filter"></i> Filter</button>
                    <a href="/reports/expense" class="btn btn-default tw-ml-2">Today</a>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="box box-danger">
            <div class="box-header with-border">
                <h3 class="box-title"><i class="fa fa-minus-circle"></i> Expense Details</h3>
            </div>
            <div class="box-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr class="bg-red">
                                <th>Category</th>
                                <th class="text-right">Total Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{range .PageData.Expenses}}
                            <tr>
                                <td>{{.CategoryName}}</td>
                                <td class="text-right text-bold">{{$.CurrencySymbol}}{{printf "%.2f" .TotalAmount}}</td>
                            </tr>
                            {{else}}
                            <tr>
                                <td colspan="2" class="text-center">No expenses found for this period.</td>
                            </tr>
                            {{end}}
                        </tbody>
                        <tfoot>
                            <tr class="bg-gray">
                                <th>Total:</th>
                                <td class="text-right text-bold">
                                    {{$.CurrencySymbol}}{{printf "%.2f" .PageData.Total}}
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{{end}}
