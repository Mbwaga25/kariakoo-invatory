{{define "title"}}Units{{end}}

{{define "header"}}Units{{end}}
{{define "subheader"}}Manage product units{{end}}

{{define "main"}}
<div class="row">
    <div class="col-md-12">
        <div class="box box-primary">
            <div class="box-header">
                <h3 class="box-title">All Units</h3>
                <div class="box-tools">
                    <button type="button" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#add_unit_modal">
                        <i class="fa fa-plus"></i> Add New Unit
                    </button>
                </div>
            </div>
            
            <div class="box-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped datatable" id="units_table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Short Name</th>
                                <th>Allow Decimal</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{range .PageData.Units}}
                            <tr>
                                <td>{{.ActualName}}</td>
                                <td>{{.ShortName}}</td>
                                <td>
                                    {{if .AllowDecimal}}
                                    <span class="label label-success">Yes</span>
                                    {{else}}
                                    <span class="label label-danger">No</span>
                                    {{end}}
                                </td>
                                <td>
                                    <div class="btn-group">
                                        <button class="btn btn-xs btn-primary edit_unit" data-id="{{.ID}}" data-name="{{.ActualName}}" data-short_name="{{.ShortName}}" data-allow_decimal="{{.AllowDecimal}}"><i class="glyphicon glyphicon-edit"></i> Edit</button>
                                        <button class="btn btn-xs btn-danger delete_unit" data-id="{{.ID}}"><i class="glyphicon glyphicon-trash"></i> Delete</button>
                                    </div>
                                </td>
                            </tr>
                            {{end}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Unit Modal -->
<div class="modal fade" id="add_unit_modal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form id="unit_add_form" action="/units/store" method="POST">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Add Unit</h4>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label for="actual_name">Unit Name:*</label>
                        <input type="text" name="actual_name" class="form-control" placeholder="Enter unit name (e.g. Kilograms)" required>
                    </div>
                    <div class="form-group">
                        <label for="short_name">Short Name:*</label>
                        <input type="text" name="short_name" class="form-control" placeholder="Enter short name (e.g. kg)" required>
                    </div>
                    <div class="form-group">
                        <label>Base Unit (for conversion):</label>
                        <select name="base_unit_id" class="form-control">
                            <option value="">None (Primary Unit)</option>
                            {{range .PageData.Units}}
                            <option value="{{.ID}}">{{.ActualName}}</option>
                            {{end}}
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Conversion Factor (e.g. 1 Box = 12 Pieces):</label>
                        <input type="number" step="0.0001" name="operation_value" class="form-control" placeholder="1.0000">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save Unit</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Unit Modal -->
<div class="modal fade" id="edit_unit_modal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form id="unit_edit_form">
                <input type="hidden" name="id" id="edit_unit_id">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Edit Unit</h4>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label for="edit_actual_name">Unit Name:*</label>
                        <input type="text" name="actual_name" id="edit_actual_name" class="form-control" placeholder="Enter unit name (e.g. Kilograms)" required>
                    </div>
                    <div class="form-group">
                        <label for="edit_short_name">Short Name:*</label>
                        <input type="text" name="short_name" id="edit_short_name" class="form-control" placeholder="Enter short name (e.g. kg)" required>
                    </div>
                    <div class="form-group">
                        <div class="checkbox">
                            <label>
                                <input type="checkbox" name="allow_decimal" id="edit_allow_decimal" value="true"> Allow Decimal
                            </label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Update Unit</button>
                </div>
            </form>
        </div>
    </div>
</div>
{{end}}

{{define "scripts"}}
<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function() {
        console.log("Units page ready.");

        // Open edit modal
        $('.edit_unit').on('click', function() {
            var id = $(this).data('id');
            var name = $(this).data('name');
            var shortName = $(this).data('short_name');
            var allowDecimal = $(this).data('allow_decimal') === true || $(this).data('allow_decimal') === 'true';
            
            $('#edit_unit_id').val(id);
            $('#edit_actual_name').val(name);
            $('#edit_short_name').val(shortName);
            $('#edit_allow_decimal').prop('checked', allowDecimal);
            
            $('#edit_unit_modal').modal('show');
        });

        // Handle edit form submit
        $('#unit_edit_form').on('submit', function(e) {
            e.preventDefault();
            var data = $(this).serialize();
            $.post('/api/units/update', data, function(res) {
                if (res.success) {
                    $('#edit_unit_modal').modal('hide');
                    toastr.success('Unit updated successfully');
                    setTimeout(function() { window.location.reload(); }, 1000);
                } else {
                    toastr.error('Failed to update unit: ' + res.message);
                }
            }).fail(function() {
                toastr.error('Network error occurred.');
            });
        });

        // Handle delete
        $('.delete_unit').on('click', function() {
            var id = $(this).data('id');
            if (confirm("Are you sure you want to delete this unit?")) {
                $.post('/api/units/delete', {id: id}, function(res) {
                    if (res.success) {
                        toastr.success('Unit deleted successfully');
                        setTimeout(function() { window.location.reload(); }, 1000);
                    } else {
                        toastr.error('Failed to delete unit: ' + res.message);
                    }
                }).fail(function() {
                    toastr.error('Network error occurred.');
                });
            }
        });
    });
</script>
{{end}}
