{{template "auth" .}}

{{define "title"}}Login{{end}}

{{define "main"}}
<div class="row">
    <div class="col-md-4 col-md-offset-4">
        <div style="text-align:center;margin-bottom:20px;">
            <h2 style="color:#1B2A4A;font-weight:700;margin:0;">CLASSIC STORE</h2>
            <p style="color:#2E7D32;font-weight:600;font-size:14px;margin:5px 0 0;">Stock Management System</p>
        </div>
        <div style="background:#fff;border-radius:16px;padding:30px;box-shadow:0 8px 30px rgba(0,0,0,0.1);border-top:4px solid #2E7D32;">
            <div style="text-align:center;margin-bottom:20px;">
                <h1 style="font-size:20px;font-weight:600;color:#1B2A4A;margin:0;">Welcome Back</h1>
                <p style="font-size:14px;color:#888;margin:5px 0 0;">Login to your Inventory App</p>
            </div>

            <form method="POST" action="/login" id="login-form">
                <div class="form-group">
                    <label style="font-size:13px;font-weight:600;color:#333;">Email</label>
                    <input class="form-control" style="height:46px;border-radius:8px;border:1px solid #D1D5DA;"
                        name="email" required autofocus placeholder="Email" type="email" id="email" />
                </div>
                <div class="form-group">
                    <label style="font-size:13px;font-weight:600;color:#333;">Password</label>
                    <input class="form-control" style="height:46px;border-radius:8px;border:1px solid #D1D5DA;"
                        id="password" type="password" name="password" required placeholder="Password" />
                </div>
                <button type="submit" style="width:100%;height:46px;border:none;border-radius:10px;background:linear-gradient(135deg,#2E7D32,#43A047);color:#fff;font-weight:600;font-size:15px;cursor:pointer;margin-top:10px;">
                    Login
                </button>
            </form>
            
            <div style="text-align:center;margin-top:20px;padding:15px;background:#F0F4F8;border-radius:10px;">
                <p style="font-size:11px;color:#666;margin:0 0 8px;">
                    <strong>System Roles:</strong>
                </p>
                <p style="font-size:11px;margin:3px 0;"><span class="role-superadmin" style="padding:2px 6px;">Super Admin</span> superadmin@test.com</p>
                <p style="font-size:11px;margin:3px 0;"><span class="role-storekeeper" style="padding:2px 6px;">Store Keeper</span> storekeeper@test.com</p>
                <p style="font-size:11px;margin:3px 0;"><span class="role-shopkeeper" style="padding:2px 6px;">Shop Keeper</span> shopkeeper@test.com</p>
                <p style="font-size:11px;margin:3px 0;color:#888;">Password: <strong>123456</strong></p>
            </div>
        </div>
    </div>
</div>
{{end}}

{{define "scripts"}}
<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function() {
        const loginForm = document.getElementById('login-form');
        if (!loginForm) return;

        console.log("Login page ready. Vanilla JS loaded.");
        
        loginForm.addEventListener('submit', function(e) {
            e.preventDefault();
            console.log("Form submitted via Fetch API...");
            
            const btn = loginForm.querySelector('button[type="submit"]');
            const originalBtnText = btn.innerText;
            const formData = new FormData(loginForm);
            const params = new URLSearchParams(formData);
            
            btn.disabled = true;
            btn.innerText = 'Logging in...';

            fetch(window.location.origin + '/login', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: params
            })
            .then(response => response.json())
            .then(data => {
                console.log("Server response:", data);
                if (data.success === "true") {
                    toastr.success(data.msg);
                    setTimeout(() => {
                        window.location.href = data.redirect;
                    }, 1000);
                } else {
                    toastr.error(data.msg);
                    btn.disabled = false;
                    btn.innerText = originalBtnText;
                }
            })
            .catch(error => {
                console.error("Fetch Error:", error);
                const msg = "An error occurred. Please try again.";
                toastr.error(msg);
                btn.disabled = false;
                btn.innerText = originalBtnText;
            });
        });
    });
</script>
{{end}}
