{{template "auth" .}}

{{define "title"}}Login{{end}}

{{define "main"}}
<div class="row">
    <div class="col-md-4 col-md-offset-4">
        <div class="tw-p-5 md:tw-p-6 tw-mb-4 tw-rounded-2xl tw-transition-all tw-duration-200 tw-bg-white tw-shadow-sm tw-ring-1 tw-ring-gray-200">
            <div class="tw-flex tw-flex-col tw-gap-4 tw-dw-rounded-box tw-dw-p-6 tw-dw-max-w-md">
                <div class="tw-flex tw-items-center tw-flex-col">
                    <h1 class="tw-text-lg md:tw-text-xl tw-font-semibold tw-text-[#1e1e1e]">
                        Welcome Back
                    </h1>
                    <h2 class="tw-text-sm tw-font-medium tw-text-gray-500">
                        Login to your Inventory App
                    </h2>
                </div>

                <form method="POST" action="/login" id="login-form">
                    <div class="form-group has-feedback">
                        <label class="tw-dw-form-control">
                            <div class="tw-dw-label">
                                <span class="tw-text-xs md:tw-text-sm tw-font-medium tw-text-black">Email</span>
                            </div>
                            <input class="tw-border tw-border-[#D1D5DA] tw-outline-none tw-h-12 tw-bg-transparent tw-rounded-lg tw-px-3 tw-font-medium tw-text-black placeholder:tw-text-gray-500"
                                name="email" required autofocus placeholder="Email" type="email" id="email" />
                        </label>
                    </div>

                    <div class="form-group has-feedback">
                        <label class="tw-dw-form-control">
                            <div class="tw-dw-label">
                                <span class="tw-text-xs md:tw-text-sm tw-font-medium tw-text-black">Password</span>
                            </div>
                            <input class="tw-border tw-border-[#D1D5DA] tw-outline-none tw-h-12 tw-bg-transparent tw-rounded-lg tw-px-3 tw-font-medium tw-text-black placeholder:tw-text-gray-500"
                                id="password" type="password" name="password" required placeholder="Password" />
                        </label>
                    </div>

                    <div class="tw-dw-form-control">
                        <label class="tw-dw-cursor-pointer tw-dw-label tw-self-start tw-gap-2">
                            <input type="checkbox" name="remember" class="tw-dw-checkbox">
                            <span class="tw-text-xs md:tw-text-sm tw-font-medium tw-text-black tw-mt-[0.2rem]">Remember Me</span>
                        </label>
                    </div>

                    <button type="submit"
                        class="tw-bg-gradient-to-r tw-from-indigo-500 tw-to-blue-500 tw-h-12 tw-rounded-xl tw-text-sm md:tw-text-base tw-text-white tw-font-semibold tw-w-full tw-max-w-full mt-2 hover:tw-from-indigo-600 hover:tw-to-blue-600">
                        Login
                    </button>
                </form>
                
                <div class="tw-text-center tw-mt-4">
                    <p class="tw-text-xs tw-text-gray-500">
                        Try logging in with any of these roles:
                        <br/><b>superadmin@test.com / 123456</b>
                        <br/><b>shopadmin@test.com / 123456</b>
                        <br/><b>shopkeeper@test.com / 123456</b>
                        <br/><b>storekeeper@test.com / 123456</b>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>
{{end}}

{{define "scripts"}}
<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function() {
        const loginForm = document.getElementById('login-form');
        if (!loginForm) return;

        console.log("Login page ready. Vanilla JS loaded.");
        
        loginForm.addEventListener('submit', function(e) {
            e.preventDefault();
            console.log("Form submitted via Fetch API...");
            
            const btn = loginForm.querySelector('button[type="submit"]');
            const originalBtnText = btn.innerText;
            const formData = new FormData(loginForm);
            const params = new URLSearchParams(formData);
            
            btn.disabled = true;
            btn.innerText = 'Logging in...';

            fetch(window.location.origin + '/login', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: params
            })
            .then(response => response.json())
            .then(data => {
                console.log("Server response:", data);
                if (data.success === "true") {
                    if (typeof toastr !== 'undefined') {
                        toastr.success(data.msg);
                    } else {
                        alert("SUCCESS: " + data.msg);
                    }
                    setTimeout(() => {
                        window.location.href = data.redirect;
                    }, 1000);
                } else {
                    if (typeof toastr !== 'undefined') {
                        toastr.error(data.msg);
                    } else {
                        alert("ERROR: " + data.msg);
                    }
                    btn.disabled = false;
                    btn.innerText = originalBtnText;
                }
            })
            .catch(error => {
                console.error("Fetch Error:", error);
                const msg = "An error occurred. Please try again.";
                if (typeof toastr !== 'undefined') {
                    toastr.error(msg);
                } else {
                    alert("NETWORK ERROR: " + msg);
                }
                btn.disabled = false;
                btn.innerText = originalBtnText;
            });
        });
    });
</script>
{{end}}
