{{define "title"}}Stock Adjustments{{end}}

{{define "header"}}Stock Adjustments{{end}}
{{define "subheader"}}Inventory corrections and adjustments{{end}}

{{define "main"}}
<div class="box box-primary">
    <div class="box-header with-border">
        <h3 class="box-title">All Adjustments</h3>
        <div class="box-tools">
            <a href="/stock-adjustments/create" class="btn btn-primary btn-sm">
                <i class="fa fa-plus"></i> Add New Adjustment
            </a>
        </div>
    </div>
    <div class="box-body">
        <div class="table-responsive">
            <table class="table table-bordered table-striped datatable" id="adjustments_table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Reference No</th>
                        <th>Location</th>
                        <th>Adjustment Type</th>
                        <th>Total Amount</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{range .PageData.Adjustments}}
                    <tr>
                        <td>{{.TransactionDate.Format "Jan 02, 2006"}}</td>
                        <td>{{.RefNo}}</td>
                        <td>{{.LocationName}}</td>
                        <td><span class="label label-info">{{.AdjustmentType}}</span></td>
                        <td>${{.FinalTotal}}</td>
                        <td>
                            <a href="/stock-adjustments/view?id={{.ID}}" class="btn btn-xs btn-info"><i class="fa fa-eye"></i> View</a>
                        </td>
                    </tr>
                    {{end}}
                </tbody>
            </table>
        </div>
    </div>
</div>
{{end}}
