{{define "title"}}Stock Adjustments{{end}}

{{define "header"}}Stock Adjustments{{end}}
{{define "subheader"}}Inventory corrections and adjustments{{end}}

{{define "main"}}
<!-- Date Filter -->
<div class="row">
    <div class="col-md-12">
        <div class="box box-primary">
            <div class="box-body">
                <form action="/stock-adjustments" method="GET" class="form-inline">
                    <div class="form-group">
                        <label>From: </label>
                        <input type="date" name="start_date" class="form-control" value="{{.PageData.Start.Format "2006-01-02"}}">
                    </div>
                    <div class="form-group tw-ml-2">
                        <label>To: </label>
                        <input type="date" name="end_date" class="form-control" value="{{.PageData.End.Format "2006-01-02"}}">
                    </div>
                    <button type="submit" class="btn btn-primary tw-ml-2"><i class="fa fa-filter"></i> Filter</button>
                    <a href="/stock-adjustments" class="btn btn-default tw-ml-2">Today</a>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="box box-primary">
    <div class="box-header with-border">
        <h3 class="box-title">All Adjustments</h3>
        <div class="box-tools">
            <a href="/stock-adjustments/create" class="btn btn-primary btn-sm">
                <i class="fa fa-plus"></i> Add New Adjustment
            </a>
        </div>
    </div>
    <div class="box-body">
        <div class="table-responsive">
            <table class="table table-bordered table-striped datatable" id="adjustments_table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Reference No</th>
                        <th>Location</th>
                        <th>Adjustment Type</th>
                        <th>Total Amount</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{range .PageData.Adjustments}}
                    <tr>
                        <td>{{.TransactionDate.Format "Jan 02, 2006"}}</td>
                        <td>{{.RefNo}}</td>
                        <td>{{.LocationName}}</td>
                        <td><span class="label label-info">{{.AdjustmentType}}</span></td>
                        <td>${{.FinalTotal}}</td>
                        <td>
                            <a href="/stock-adjustments/view?id={{.ID}}" class="btn btn-xs btn-info"><i class="fa fa-eye"></i> View</a>
                        </td>
                    </tr>
                    {{end}}
                </tbody>
            </table>
        </div>
    </div>
</div>
{{end}}
