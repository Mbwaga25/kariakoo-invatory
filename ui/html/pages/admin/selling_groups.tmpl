{{define "title"}}Selling Price Groups{{end}}

{{define "header"}}Selling Price Groups{{end}}
{{define "subheader"}}Manage wholesale, retail, VIP and custom selling price tiers{{end}}

{{define "main"}}
<div class="box box-primary">
    <div class="box-header with-border">
        <h3 class="box-title"><i class="fa fa-tags"></i> Selling Price Groups</h3>
        <div class="box-tools">
            <button type="button" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#addGroupModal">
                <i class="fa fa-plus"></i> Add New Group
            </button>
        </div>
    </div>
    <div class="box-body">
        <div class="table-responsive">
            <table class="table table-bordered table-striped datatable" id="groups_table" style="width:100%">
                <thead>
                    <tr style="background: #f8fafc; color: #1B2A4A;">
                        <th>Name</th>
                        <th>Description</th>
                        <th style="width: 15%">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{range .PageData.Groups}}
                    <tr>
                        <td><strong>{{.Name}}</strong></td>
                        <td>{{.Description}}</td>
                        <td>
                            <div class="btn-group">
                                <button class="btn btn-xs btn-primary edit-group" 
                                        data-id="{{.ID}}"
                                        data-name="{{.Name}}"
                                        data-description="{{.Description}}">
                                    <i class="fa fa-edit"></i> Edit
                                </button>
                                <a href="/selling-price-groups/delete?id={{.ID}}" class="btn btn-xs btn-danger" onclick="return confirm('Are you sure you want to delete this selling price group? All associated product prices in this group will be deleted.')">
                                    <i class="fa fa-trash"></i> Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                    {{else}}
                    <tr>
                        <td colspan="3" class="text-center text-muted" style="padding: 20px;">No selling price groups created yet.</td>
                    </tr>
                    {{end}}
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Modal -->
<div class="modal fade" id="addGroupModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form action="/selling-price-groups/store" method="POST">
                <div class="modal-header bg-primary" style="color: white;">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title"><i class="fa fa-plus"></i> Add Selling Price Group</h4>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label>Name:*</label>
                        <input type="text" name="name" class="form-control" required placeholder="e.g. Wholesale Customer">
                    </div>
                    <div class="form-group">
                        <label>Description:</label>
                        <textarea name="description" class="form-control" rows="3" placeholder="Optional description for this pricing tier..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save Group</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editGroupModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form action="/selling-price-groups/update" method="POST">
                <input type="hidden" name="id" id="edit_id">
                <div class="modal-header bg-primary" style="color: white;">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title"><i class="fa fa-edit"></i> Edit Selling Price Group</h4>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label>Name:*</label>
                        <input type="text" name="name" id="edit_name" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Description:</label>
                        <textarea name="description" id="edit_description" class="form-control" rows="3"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Update Group</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    if ($.fn.DataTable && !$.fn.DataTable.isDataTable('#groups_table')) {
        $('#groups_table').DataTable({
            responsive: true
        });
    }

    $('.edit-group').click(function() {
        const data = $(this).data();
        $('#edit_id').val(data.id);
        $('#edit_name').val(data.name);
        $('#edit_description').val(data.description);
        $('#editGroupModal').modal('show');
    });
});
</script>
{{end}}
