{{define "title"}}User Management{{end}}

{{define "header"}}Users{{end}}
{{define "subheader"}}Manage your employees and permissions{{end}}

{{define "main"}}
<div class="row">
    <div class="col-md-4">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h3 class="box-title">Add New User</h3>
            </div>
            <form action="/users/store" method="POST">
                <div class="box-body">
                    <div class="form-group">
                        <label>Full Name:*</label>
                        <input type="text" name="name" class="form-control" required placeholder="John Doe">
                    </div>
                    <div class="form-group">
                        <label>Email Address:*</label>
                        <input type="email" name="email" class="form-control" required placeholder="john@example.com">
                    </div>
                    <div class="form-group">
                        <label>Password:*</label>
                        <input type="password" name="password" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Role:*</label>
                        <select name="role" class="form-control" required>
                            <option value="ShopKeeper">Shop Keeper</option>
                            <option value="ShopAdmin">Shop Admin (Creates New Tenant)</option>
                            <option value="Cashier">Cashier</option>
                        </select>
                        <p class="help-block">Note: Shop Admin creates a new tenant isolate.</p>
                    </div>
                </div>
                <div class="box-footer">
                    <button type="submit" class="btn btn-primary btn-block">Create User & Onboard</button>
                </div>
            </form>
        </div>
    </div>
    <div class="col-md-8">
        <div class="box box-info">
            <div class="box-header with-border">
                <h3 class="box-title">Recent Users</h3>
            </div>
            <div class="box-body">
                <p class="text-muted">User list for this tenant will appear here.</p>
                <!-- Add actual user list here if needed -->
            </div>
        </div>
    </div>
</div>
{{end}}
