{{define "title"}}User Management{{end}}

{{define "header"}}Users{{end}}
{{define "subheader"}}Manage Store Keepers, Shop Keepers & Admins{{end}}

{{define "main"}}
<div class="row">
    <div class="col-md-4">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h3 class="box-title"><i class="fa fa-user-plus"></i> Add New User</h3>
            </div>
            <form action="/users/store" method="POST">
                <div class="box-body">
                    <div class="form-group">
                        <label>Full Name:*</label>
                        <input type="text" name="name" class="form-control" required placeholder="John Doe">
                    </div>
                    <div class="form-group">
                        <label>Email Address:*</label>
                        <input type="email" name="email" class="form-control" required placeholder="john@example.com">
                    </div>
                    <div class="form-group">
                        <label>Password:*</label>
                        <input type="password" name="password" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Role:*</label>
                        <select name="role" id="role" class="form-control" required>
                            <option value="StoreKeeper">Store Keeper (Manage Stock & Orders)</option>
                            <option value="ShopKeeper">Shop Keeper (Place Orders)</option>
                            {{if eq .PageData.UserRole "SuperAdmin"}}
                            <option value="ShopAdmin">Shop Admin (New Tenant)</option>
                            {{end}}
                        </select>
                        <div style="margin-top:10px;padding:10px;background:#F0F4F8;border-radius:8px;font-size:12px;">
                            <p style="margin:3px 0;"><span class="role-storekeeper">Store Keeper</span> - Manages stock, receives and processes orders</p>
                            <p style="margin:3px 0;"><span class="role-shopkeeper">Shop Keeper</span> - Places store and bulk orders</p>
                            <p style="margin:3px 0;"><span class="role-shopadmin">Shop Admin</span> - Creates a new tenant</p>
                        </div>
                    </div>
                    {{if gt (len .PageData.Locations) 0}}
                    <div class="form-group" id="location_group" style="display:none;">
                        <label>Location:*</label>
                        <select name="location_id" id="location_id" class="form-control">
                            <option value="">-- Select Location --</option>
                            {{range .PageData.Locations}}
                            <option value="{{.ID}}">{{if .TenantName}}{{.TenantName}} - {{end}}{{.Name}}{{if .LocationType}} ({{.LocationType}}){{end}}</option>
                            {{end}}
                        </select>
                        <p class="help-block">Required for Store Keeper and Shop Keeper users.</p>
                    </div>
                    {{end}}
                </div>
                <div class="box-footer">
                    <button type="submit" class="btn btn-primary btn-block">
                        <i class="fa fa-check"></i> Create User & Onboard
                    </button>
                </div>
            </form>
        </div>
    </div>
    <div class="col-md-8">
        <div class="box box-info">
            <div class="box-header with-border">
                <h3 class="box-title"><i class="fa fa-users"></i> All Users</h3>
            </div>
            <div class="box-body">
                <table class="table table-striped table-hover" id="usersTable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Joined</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{range .PageData.Users}}
                        <tr>
                            <td>{{.ID}}</td>
                            <td><strong>{{.Name}}</strong></td>
                            <td>{{.Email}}</td>
                            <td>
                                {{if eq .Role "SuperAdmin"}}<span class="role-superadmin">Super Admin</span>
                                {{else if eq .Role "StoreKeeper"}}<span class="role-storekeeper">Store Keeper</span>
                                {{else if eq .Role "ShopKeeper"}}<span class="role-shopkeeper">Shop Keeper</span>
                                {{else if eq .Role "ShopAdmin"}}<span class="role-shopadmin">Shop Admin</span>
                                {{else}}<span class="label label-default">{{.Role}}</span>
                                {{end}}
                            </td>
                            <td>{{.CreatedAt.Format "Jan 02, 2006"}}</td>
                        </tr>
                        {{else}}
                        <tr><td colspan="5" class="text-center">No users found</td></tr>
                        {{end}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{{end}}

{{define "scripts"}}
<script>
$(document).ready(function() {
    const locationGroup = $('#location_group');
    const roleSelect = $('#role');

    function toggleLocationField() {
        if (!locationGroup.length) {
            return;
        }

        if (roleSelect.val() === 'ShopAdmin') {
            locationGroup.hide();
            $('#location_id').val('');
        } else {
            locationGroup.show();
        }
    }

    roleSelect.on('change', toggleLocationField);
    toggleLocationField();

    $('#usersTable').DataTable({"pageLength": 25});
});
</script>
{{end}}
