{{define "title"}}Select Shop Location{{end}}

{{define "header"}}Select Location{{end}}
{{define "subheader"}}Choose the shop where you are selling from{{end}}

{{define "main"}}
<div class="row">
    <div class="col-md-6 col-md-offset-3">
        <div class="box box-primary">
            <div class="box-header with-border text-center">
                <h3 class="box-title">Available Locations</h3>
            </div>
            <div class="box-body">
                <div class="list-group">
                    {{range .PageData.Locations}}
                    <a href="/pos/create?location_id={{.ID}}" class="list-group-item list-group-item-action tw-p-6 tw-text-center">
                        <i class="fa fa-map-marker fa-3x text-primary"></i>
                        <h4 class="tw-font-bold">{{.Name}}</h4>
                        <p class="text-muted">{{.City}}, {{.Country}}</p>
                    </a>
                    {{else}}
                    <div class="alert alert-warning">No business locations found. Please add a location in settings first.</div>
                    {{end}}
                </div>
            </div>
        </div>
    </div>
</div>
{{end}}
