{{define "title"}}Sales List{{end}}

{{define "header"}}Sales{{end}}
{{define "subheader"}}Manage your sales transactions{{end}}

{{define "main"}}
<div class="box box-primary">
    <div class="box-header with-border">
        <h3 class="box-title">All Sales</h3>
        <div class="box-tools">
            <a href="/pos/create" class="btn btn-primary btn-sm">
                <i class="fa fa-plus"></i> Add New Sale
            </a>
        </div>
    </div>
    <div class="box-body">
        <div class="table-responsive">
            <table class="table table-bordered table-striped datatable" id="sales_table">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Invoice No</th>
                        <th>Customer</th>
                        <th>Status</th>
                        <th>Payment Status</th>
                        <th>Final Total</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{range .PageData.Sales}}
                    <tr>
                        <td>{{.TransactionDate.Format "Jan 02, 2006 15:04"}}</td>
                        <td>{{.InvoiceNo}}</td>
                        <td>{{if .CustomerID}}Customer ID: {{.CustomerID}}{{else}}Walk-in Customer{{end}}</td>
                        <td><span class="label label-info">{{.Status}}</span></td>
                        <td><span class="label label-warning">{{.PaymentStatus}}</span></td>
                        <td>${{.FinalTotal}}</td>
                        <td>
                            <a href="/sales/view?id={{.ID}}" class="btn btn-xs btn-info"><i class="fa fa-eye"></i> View</a>
                            <a href="/sales/print?id={{.ID}}" class="btn btn-xs btn-default"><i class="fa fa-print"></i> Print</a>
                        </td>
                    </tr>
                    {{end}}
                </tbody>
            </table>
        </div>
    </div>
</div>
{{end}}
