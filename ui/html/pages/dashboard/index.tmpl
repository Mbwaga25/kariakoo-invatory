{{define "title"}}Dashboard{{end}}
{{define "header"}}Dashboard{{end}}
{{define "subheader"}}Business Overview{{end}}

{{define "main"}}
<!-- Date Range Filter -->
<div class="row" style="margin-bottom: 20px;">
    <div class="col-md-12">
        <div class="box box-solid" style="border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -1px rgba(0,0,0,0.03); border: 1px solid #e2e8f0; margin-bottom: 0;">
            <div class="box-body" style="padding: 15px;">
                <form action="/dashboard" method="GET" class="form-inline" id="dashboardFilterForm" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 15px;">
                    <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                        <div class="form-group" style="margin-bottom: 0;">
                            <label style="margin-right: 8px; font-weight: 600; color: #1b2a4a; display: inline-flex; align-items: center; gap: 5px;">
                                <i class="fa fa-calendar-alt text-primary" style="font-size: 16px;"></i> Time Period:
                            </label>
                            <select name="preset" id="dashboardPreset" class="form-control" style="border-radius: 6px; border-color: #cbd5e1; height: 36px; padding: 6px 12px; font-weight: 500;">
                                <option value="today" {{if eq .PageData.Preset "today"}}selected{{end}}>Today</option>
                                <option value="yesterday" {{if eq .PageData.Preset "yesterday"}}selected{{end}}>Yesterday</option>
                                <option value="weekly" {{if eq .PageData.Preset "weekly"}}selected{{end}}>This Week</option>
                                <option value="monthly" {{if eq .PageData.Preset "monthly"}}selected{{end}}>This Month</option>
                                <option value="yearly" {{if eq .PageData.Preset "yearly"}}selected{{end}}>This Year</option>
                                <option value="custom" {{if eq .PageData.Preset "custom"}}selected{{end}}>Custom Range</option>
                            </select>
                        </div>
                        
                        <div class="form-group" id="dashboardCustomRange" style="margin-bottom: 0; display: {{if eq .PageData.Preset "custom"}}inline-flex{{else}}none{{end}}; align-items: center; gap: 8px;">
                            <input type="date" name="start_date" id="dashboardStart" class="form-control" value="{{.PageData.StartDate}}" style="border-radius: 6px; border-color: #cbd5e1; height: 36px; width: 140px;">
                            <span style="color: #64748b; font-weight: 500;">to</span>
                            <input type="date" name="end_date" id="dashboardEnd" class="form-control" value="{{.PageData.EndDate}}" style="border-radius: 6px; border-color: #cbd5e1; height: 36px; width: 140px;">
                        </div>
                    </div>
                    
                    <div>
                        <button type="submit" class="btn btn-primary" style="border-radius: 6px; height: 36px; padding: 6px 16px; font-weight: 600; background-color: #1b2a4a; border-color: #1b2a4a; box-shadow: 0 1px 2px rgba(0,0,0,0.05); display: inline-flex; align-items: center; gap: 6px;">
                            <i class="fa fa-sync-alt"></i> Apply Filter
                        </button>
                        {{if ne .PageData.Preset "today"}}
                        <a href="/dashboard" class="btn btn-default" style="border-radius: 6px; height: 36px; padding: 6px 16px; font-weight: 500; border-color: #cbd5e1; display: inline-flex; align-items: center; gap: 6px; margin-left: 8px;">
                            Reset
                        </a>
                        {{end}}
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Dashboard Overview -->
<div class="row">
    <!-- Stat Cards -->
    <div class="col-md-3 col-sm-6">
        <div class="info-box bg-navy">
            <span class="info-box-icon"><i class="fa fa-shopping-basket"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Total Orders</span>
                <span class="info-box-number">{{.PageData.OrderSummary.TotalOrders}}</span>
                <div class="progress"><div class="progress-bar" style="width: 100%"></div></div>
                <span class="progress-description">All-time order volume</span>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="info-box bg-orange">
            <span class="info-box-icon"><i class="fa fa-clock"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Pending Orders</span>
                <span class="info-box-number">{{.PageData.OrderSummary.PendingOrders}}</span>
                <div class="progress"><div class="progress-bar" style="width: 70%"></div></div>
                <span class="progress-description">Awaiting processing</span>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="info-box bg-red">
            <span class="info-box-icon"><i class="fa fa-exclamation-triangle"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Stock Alerts</span>
                <span class="info-box-number">{{.PageData.Data.StockAlertsCount}}</span>
                <div class="progress"><div class="progress-bar" style="width: 100%"></div></div>
                <span class="progress-description">Items below threshold</span>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="info-box bg-green">
            <span class="info-box-icon"><i class="fa fa-check-circle"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Accepted Orders</span>
                <span class="info-box-number">{{.PageData.OrderSummary.AcceptedOrders}}</span>
                <div class="progress"><div class="progress-bar" style="width: 100%"></div></div>
                <span class="progress-description">Successfully dispatched</span>
            </div>
        </div>
    </div>
</div>

<!-- Order Flow Chart -->
<div class="row">
    <div class="col-md-12">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h3 class="box-title"><i class="fa fa-chart-line"></i> Logistics Flow: Daily Order Frequency (Last 30 Days)</h3>
                <div class="box-tools pull-right">
                    <button type="button" class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                </div>
            </div>
            <div class="box-body">
                <div class="chart">
                    <canvas id="orderFlowChart" style="height: 250px;"></canvas>
                </div>
            </div>
            <div class="box-footer">
                <div class="row">
                    <div class="col-sm-3 col-xs-6">
                        <div class="description-block border-right">
                            <h5 class="description-header text-primary">{{.PageData.OrderSummary.TotalOrders}}</h5>
                            <span class="description-text">TOTAL FLOW</span>
                        </div>
                    </div>
                    <div class="col-sm-3 col-xs-6">
                        <div class="description-block border-right">
                            <h5 class="description-header text-yellow">{{.PageData.OrderSummary.PendingOrders}}</h5>
                            <span class="description-text">IN TRANSIT</span>
                        </div>
                    </div>
                    <div class="col-sm-3 col-xs-6">
                        <div class="description-block border-right">
                            <h5 class="description-header text-green">{{.PageData.OrderSummary.AcceptedOrders}}</h5>
                            <span class="description-text">COMPLETED</span>
                        </div>
                    </div>
                    <div class="col-sm-3 col-xs-6">
                        <div class="description-block">
                            <h5 class="description-header text-red">{{.PageData.Data.StockAlertsCount}}</h5>
                            <span class="description-text">CRITICAL ALERTS</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Order Flow Table -->
<div class="row">
    <div class="col-md-12">
        <div class="box box-info">
            <div class="box-header with-border">
                <h3 class="box-title"><i class="fa fa-exchange-alt"></i> Recent Order Traffic</h3>
                <div class="pull-right">
                    <a href="/orders" class="btn btn-xs btn-default">View All Traffic</a>
                </div>
            </div>
            <div class="box-body no-padding">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead style="background:#F4F7F9;">
                            <tr>
                                <th>Ref No</th>
                                <th>Type</th>
                                <th>Routing (Source → Destination)</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Timestamp</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{range .PageData.Data.RecentOrders}}
                            <tr>
                                <td><code>{{.RefNo}}</code></td>
                                <td>
                                    {{if eq .OrderType "StoreOrder"}}
                                    <span class="label" style="background:#2E7D32;">STORE-TO-SHOP</span>
                                    {{else}}
                                    <span class="label" style="background:#0277BD;">BULK-DISPATCH</span>
                                    {{end}}
                                </td>
                                <td>
                                    {{if .FromLocationName}}
                                    <span class="text-danger">{{.FromLocationName}}</span> 
                                    <i class="fa fa-long-arrow-alt-right" style="margin:0 5px;"></i>
                                    {{end}}
                                    <span class="text-success">{{.ToLocationName}}</span>
                                </td>
                                <td>{{$.CurrencySymbol}}{{printf "%.2f" .TotalAmount}}</td>
                                <td><span class="badge-{{.Status}}">{{.Status}}</span></td>
                                <td>{{.CreatedAt.Format "Jan 02, 15:04"}}</td>
                            </tr>
                            {{else}}
                            <tr><td colspan="6" class="text-center text-muted" style="padding:20px;">No recent traffic detected.</td></tr>
                            {{end}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Product Stock Alerts Table -->
<div class="row" style="margin-top: 20px;">
    <div class="col-md-12">
        <div class="box box-danger" style="border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.05), 0 2px 4px -1px rgba(0,0,0,0.03); border: 1px solid #cbd5e1;">
            <div class="box-header with-border" style="padding: 15px; border-bottom: 1px solid #cbd5e1;">
                <h3 class="box-title" style="display: inline-flex; align-items: center; gap: 8px; font-weight: 700; color: #b91c1c;">
                    <i class="fa fa-exclamation-triangle text-red"></i> Critical Stock Alerts
                    <span class="label label-danger" style="border-radius: 12px; padding: 2px 8px; font-size: 12px;">{{len .PageData.LowStock}}</span>
                </h3>
                <div class="pull-right">
                    <a href="/products" class="btn btn-xs btn-default" style="border-radius: 4px; padding: 4px 8px; font-weight: 500;">View All Products</a>
                </div>
            </div>
            <div class="box-body no-padding">
                <div class="table-responsive">
                    <table class="table table-hover" style="margin-bottom: 0;">
                        <thead style="background: #fdf2f2; color: #991b1b;">
                            <tr>
                                <th style="padding: 12px 15px; font-weight: 600; font-size: 13px;">Type</th>
                                <th style="padding: 12px 15px; font-weight: 600; font-size: 13px;">Product Name</th>
                                <th style="padding: 12px 15px; font-weight: 600; font-size: 13px;">SKU</th>
                                <th style="padding: 12px 15px; font-weight: 600; font-size: 13px;">Current Stock</th>
                                <th style="padding: 12px 15px; font-weight: 600; font-size: 13px;">Alert Level</th>
                                <th style="padding: 12px 15px; font-weight: 600; font-size: 13px; text-align: right;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{range .PageData.LowStock}}
                            <tr>
                                <td style="padding: 12px 15px; vertical-align: middle;">
                                    <span class="product-type-badge" style="background-color: #f1f5f9; color: #475569; font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 6px; text-transform: uppercase;">
                                        {{.ProductType}}
                                    </span>
                                </td>
                                <td style="padding: 12px 15px; vertical-align: middle; font-weight: 700; color: #1e293b;">
                                    {{.Name}}
                                </td>
                                <td style="padding: 12px 15px; vertical-align: middle;">
                                    <span style="font-family: monospace; font-size: 12px; background: #f1f5f9; padding: 2px 6px; border-radius: 4px; color: #334155;">{{.SKU}}</span>
                                </td>
                                <td style="padding: 12px 15px; vertical-align: middle;">
                                    <span class="label {{if le .LocationQty 0.0}}label-danger{{else}}label-warning{{end}}" style="font-size: 12px; font-weight: 700; padding: 4px 10px; border-radius: 8px;">
                                        {{printf "%.0f" .LocationQty}} available
                                    </span>
                                </td>
                                <td style="padding: 12px 15px; vertical-align: middle; color: #64748b; font-size: 13px; font-weight: 500;">
                                    Below {{printf "%.0f" (derefFloat .AlertQuantity)}}
                                </td>
                                <td style="padding: 12px 15px; vertical-align: middle; text-align: right;">
                                    <a href="/purchases/create?product_id={{.ID}}" class="btn btn-sm btn-success" style="border-radius: 6px; font-weight: 600; font-size: 12px; padding: 5px 12px; background-color: #16a34a; border-color: #16a34a; display: inline-flex; align-items: center; gap: 4px;">
                                        <i class="fa fa-plus-circle"></i> Receive Stock
                                    </a>
                                </td>
                            </tr>
                            {{else}}
                            <tr>
                                <td colspan="6" class="text-center text-muted" style="padding: 30px; font-size: 14px; font-weight: 500; color: #64748b;">
                                    <i class="fa fa-check-circle text-success" style="font-size: 24px; display: block; margin-bottom: 8px;"></i>
                                    Excellent! No products are currently below low stock alert thresholds.
                                </td>
                            </tr>
                            {{end}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

{{end}}

{{define "scripts"}}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
$(function () {
    var ctx = document.getElementById('orderFlowChart').getContext('2d');
    var chartData = {
        labels: [{{range .PageData.Data.DailyOrderFlow}}'{{.Date}}',{{end}}],
        datasets: [{
            label: 'Orders Dispatched',
            data: [{{range .PageData.Data.DailyOrderFlow}}{{.Count}},{{end}}],
            backgroundColor: 'rgba(27, 42, 74, 0.1)',
            borderColor: '#1B2A4A',
            borderWidth: 2,
            pointRadius: 4,
            pointBackgroundColor: '#1B2A4A',
            fill: true,
            tension: 0.4
        }]
    };

    new Chart(ctx, {
        type: 'line',
        data: chartData,
        options: {
            maintainAspectRatio: false,
            responsive: true,
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: { stepSize: 1 }
                }
            },
            plugins: {
                legend: { display: false }
            }
        }
    });

    $('#dashboardPreset').change(function() {
        if ($(this).val() === 'custom') {
            $('#dashboardCustomRange').css('display', 'inline-flex');
        } else {
            $('#dashboardCustomRange').hide();
            $('#dashboardFilterForm').submit();
        }
    });
});
</script>
{{end}}


