{{define "title"}}Dashboard{{end}}
{{define "header"}}Dashboard{{end}}
{{define "subheader"}}Business Overview{{end}}

{{define "main"}}
<!-- Dashboard Overview -->
<div class="row">
    <!-- Stat Cards -->
    <div class="col-md-3 col-sm-6">
        <div class="info-box bg-navy">
            <span class="info-box-icon"><i class="fa fa-shopping-basket"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Total Orders</span>
                <span class="info-box-number">{{.PageData.OrderSummary.TotalOrders}}</span>
                <div class="progress"><div class="progress-bar" style="width: 100%"></div></div>
                <span class="progress-description">All-time order volume</span>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="info-box bg-orange">
            <span class="info-box-icon"><i class="fa fa-clock"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Pending Orders</span>
                <span class="info-box-number">{{.PageData.OrderSummary.PendingOrders}}</span>
                <div class="progress"><div class="progress-bar" style="width: 70%"></div></div>
                <span class="progress-description">Awaiting processing</span>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="info-box bg-red">
            <span class="info-box-icon"><i class="fa fa-exclamation-triangle"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Stock Alerts</span>
                <span class="info-box-number">{{.PageData.Data.StockAlertsCount}}</span>
                <div class="progress"><div class="progress-bar" style="width: 100%"></div></div>
                <span class="progress-description">Items below threshold</span>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="info-box bg-green">
            <span class="info-box-icon"><i class="fa fa-check-circle"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Accepted Orders</span>
                <span class="info-box-number">{{.PageData.OrderSummary.AcceptedOrders}}</span>
                <div class="progress"><div class="progress-bar" style="width: 100%"></div></div>
                <span class="progress-description">Successfully dispatched</span>
            </div>
        </div>
    </div>
</div>

<!-- Order Flow Chart -->
<div class="row">
    <div class="col-md-12">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h3 class="box-title"><i class="fa fa-chart-line"></i> Logistics Flow: Daily Order Frequency (Last 30 Days)</h3>
                <div class="box-tools pull-right">
                    <button type="button" class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                </div>
            </div>
            <div class="box-body">
                <div class="chart">
                    <canvas id="orderFlowChart" style="height: 250px;"></canvas>
                </div>
            </div>
            <div class="box-footer">
                <div class="row">
                    <div class="col-sm-3 col-xs-6">
                        <div class="description-block border-right">
                            <h5 class="description-header text-primary">{{.PageData.OrderSummary.TotalOrders}}</h5>
                            <span class="description-text">TOTAL FLOW</span>
                        </div>
                    </div>
                    <div class="col-sm-3 col-xs-6">
                        <div class="description-block border-right">
                            <h5 class="description-header text-yellow">{{.PageData.OrderSummary.PendingOrders}}</h5>
                            <span class="description-text">IN TRANSIT</span>
                        </div>
                    </div>
                    <div class="col-sm-3 col-xs-6">
                        <div class="description-block border-right">
                            <h5 class="description-header text-green">{{.PageData.OrderSummary.AcceptedOrders}}</h5>
                            <span class="description-text">COMPLETED</span>
                        </div>
                    </div>
                    <div class="col-sm-3 col-xs-6">
                        <div class="description-block">
                            <h5 class="description-header text-red">{{.PageData.Data.StockAlertsCount}}</h5>
                            <span class="description-text">CRITICAL ALERTS</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Order Flow Table -->
<div class="row">
    <div class="col-md-12">
        <div class="box box-info">
            <div class="box-header with-border">
                <h3 class="box-title"><i class="fa fa-exchange-alt"></i> Recent Order Traffic</h3>
                <div class="pull-right">
                    <a href="/orders" class="btn btn-xs btn-default">View All Traffic</a>
                </div>
            </div>
            <div class="box-body no-padding">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead style="background:#F4F7F9;">
                            <tr>
                                <th>Ref No</th>
                                <th>Type</th>
                                <th>Routing (Source → Destination)</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Timestamp</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{range .PageData.Data.RecentOrders}}
                            <tr>
                                <td><code>{{.RefNo}}</code></td>
                                <td>
                                    {{if eq .OrderType "StoreOrder"}}
                                    <span class="label" style="background:#2E7D32;">STORE-TO-SHOP</span>
                                    {{else}}
                                    <span class="label" style="background:#0277BD;">BULK-DISPATCH</span>
                                    {{end}}
                                </td>
                                <td>
                                    {{if .FromLocationName}}
                                    <span class="text-danger">{{.FromLocationName}}</span> 
                                    <i class="fa fa-long-arrow-alt-right" style="margin:0 5px;"></i>
                                    {{end}}
                                    <span class="text-success">{{.ToLocationName}}</span>
                                </td>
                                <td>{{$.CurrencySymbol}}{{printf "%.2f" .TotalAmount}}</td>
                                <td><span class="badge-{{.Status}}">{{.Status}}</span></td>
                                <td>{{.CreatedAt.Format "Jan 02, 15:04"}}</td>
                            </tr>
                            {{else}}
                            <tr><td colspan="6" class="text-center text-muted" style="padding:20px;">No recent traffic detected.</td></tr>
                            {{end}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

{{end}}

{{define "scripts"}}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
$(function () {
    var ctx = document.getElementById('orderFlowChart').getContext('2d');
    var chartData = {
        labels: [{{range .PageData.Data.DailyOrderFlow}}'{{.Date}}',{{end}}],
        datasets: [{
            label: 'Orders Dispatched',
            data: [{{range .PageData.Data.DailyOrderFlow}}{{.Count}},{{end}}],
            backgroundColor: 'rgba(27, 42, 74, 0.1)',
            borderColor: '#1B2A4A',
            borderWidth: 2,
            pointRadius: 4,
            pointBackgroundColor: '#1B2A4A',
            fill: true,
            tension: 0.4
        }]
    };

    new Chart(ctx, {
        type: 'line',
        data: chartData,
        options: {
            maintainAspectRatio: false,
            responsive: true,
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: { stepSize: 1 }
                }
            },
            plugins: {
                legend: { display: false }
            }
        }
    });
});
</script>
{{end}}


