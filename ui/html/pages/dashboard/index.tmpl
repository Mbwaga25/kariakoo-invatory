{{define "title"}}Dashboard{{end}}
{{define "header"}}Dashboard{{end}}
{{define "subheader"}}Control panel{{end}}

{{define "main"}}
<!-- Date Filter -->
<div class="row">
    <div class="col-md-12">
        <div class="box box-primary">
            <div class="box-body">
                <form action="/" method="GET" class="form-inline">
                    <div class="form-group">
                        <label>From: </label>
                        <input type="date" name="start_date" class="form-control" value="{{.PageData.Start.Format "2006-01-02"}}">
                    </div>
                    <div class="form-group tw-ml-2">
                        <label>To: </label>
                        <input type="date" name="end_date" class="form-control" value="{{.PageData.End.Format "2006-01-02"}}">
                    </div>
                    <button type="submit" class="btn btn-primary tw-ml-2"><i class="fa fa-filter"></i> Filter</button>
                    <a href="/" class="btn btn-default tw-ml-2">Today</a>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Info boxes -->
<div class="row">
    <div class="col-md-3 col-sm-6 col-xs-12">
        <div class="info-box">
            <span class="info-box-icon bg-aqua"><i class="fa fa-shopping-cart"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Total Sales</span>
                <span class="info-box-number" id="total_sales">{{.CurrencySymbol}}{{printf "%.2f" .PageData.Data.TotalSales}}</span>
            </div>
        </div>
    </div>
    
    <div class="col-md-3 col-sm-6 col-xs-12">
        <div class="info-box">
            <span class="info-box-icon bg-green"><i class="fa fa-money-bill-wave"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Net Profit</span>
                <span class="info-box-number" id="net_profit">{{printf "%.2f" .PageData.Data.Net}}</span>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-sm-6 col-xs-12">
        <div class="info-box">
            <span class="info-box-icon bg-yellow"><i class="fa fa-file-invoice-dollar"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Invoice Due</span>
                <span class="info-box-number" id="invoice_due">{{.CurrencySymbol}}{{printf "%.2f" .PageData.Data.InvoiceDue}}</span>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-sm-6 col-xs-12">
        <div class="info-box">
            <span class="info-box-icon bg-red"><i class="fa fa-undo"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Sell Return</span>
                <span class="info-box-number" id="sell_return">{{printf "%.2f" .PageData.Data.TotalSellReturn}}</span>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-3 col-sm-6 col-xs-12">
        <div class="info-box">
            <span class="info-box-icon bg-blue"><i class="fa fa-truck-loading"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Total Purchase</span>
                <span class="info-box-number" id="total_purchase">{{.CurrencySymbol}}{{printf "%.2f" .PageData.Data.TotalPurchases}}</span>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-sm-6 col-xs-12">
        <div class="info-box">
            <span class="info-box-icon bg-orange"><i class="fa fa-exclamation-triangle"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Purchase Due</span>
                <span class="info-box-number" id="purchase_due">{{printf "%.2f" .PageData.Data.PurchaseDue}}</span>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-sm-6 col-xs-12">
        <div class="info-box">
            <span class="info-box-icon bg-purple"><i class="fa fa-minus-circle"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Total Expense</span>
                <span class="info-box-number" id="total_expense">{{.CurrencySymbol}}{{printf "%.2f" .PageData.Data.TotalExpenses}}</span>
            </div>
        </div>
    </div>

    <div class="col-md-3 col-sm-6 col-xs-12">
        <div class="info-box bg-red">
            <span class="info-box-icon"><i class="fa fa-boxes"></i></span>
            <div class="info-box-content">
                <span class="info-box-text">Stock Alerts</span>
                <span class="info-box-number">{{.PageData.Data.StockAlertsCount}}</span>
                <div class="progress">
                    <div class="progress-bar" style="width: 70%"></div>
                </div>
                <span class="progress-description">Items below alert level</span>
            </div>
        </div>
    </div>
</div>

<!-- Sales Chart -->
<div class="row">
    <div class="col-md-12">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h3 class="box-title"><i class="fa fa-chart-line"></i> Sells Last 30 Days</h3>
                <div class="box-tools pull-right">
                    <button type="button" class="btn btn-box-tool" data-widget="collapse"><i class="fa fa-minus"></i></button>
                </div>
            </div>
            <div class="box-body">
                <div class="chart">
                    <canvas id="salesChart" style="height: 300px;"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tables Row 1: Stock Alerts & Recent Sales -->
<div class="row">
    <div class="col-md-6">
        <div class="box box-danger">
            <div class="box-header with-border">
                <h3 class="box-title">Stock Alerts</h3>
            </div>
            <div class="box-body no-padding">
                <table class="table table-condensed">
                    <tr>
                        <th>Product</th>
                        <th>SKU</th>
                        <th>Qty</th>
                    </tr>
                    {{range .PageData.Data.StockAlerts}}
                    <tr>
                        <td>{{.Name}}</td>
                        <td>{{.SKU}}</td>
                        <td><span class="label label-danger">{{.LocationQty}}</span></td>
                    </tr>
                    {{else}}
                    <tr><td colspan="3" class="text-center">No low stock items</td></tr>
                    {{end}}
                </table>
            </div>
            <div class="box-footer text-center">
                <a href="/products" class="uppercase">View All Products</a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="box box-info">
            <div class="box-header with-border">
                <h3 class="box-title">Recent Sales</h3>
            </div>
            <div class="box-body no-padding">
                <table class="table table-condensed">
                    <tr>
                        <th>Invoice</th>
                        <th>Total</th>
                        <th>Status</th>
                    </tr>
                    {{range .PageData.Data.RecentSales}}
                    <tr>
                        <td>{{.InvoiceNo}}</td>
                        <td>{{$.CurrencySymbol}}{{printf "%.2f" .FinalTotal}}</td>
                        <td><span class="label label-success">{{.Status}}</span></td>
                    </tr>
                    {{else}}
                    <tr><td colspan="3" class="text-center">No recent sales</td></tr>
                    {{end}}
                </table>
            </div>
            <div class="box-footer text-center">
                <a href="/sales" class="uppercase">View All Sales</a>
            </div>
        </div>
    </div>
</div>

<!-- Tables Row 2: Recent Transfers & Pending Orders -->
<div class="row">
    <div class="col-md-6">
        <div class="box box-warning">
            <div class="box-header with-border">
                <h3 class="box-title">Recent Transfers</h3>
            </div>
            <div class="box-body no-padding">
                <table class="table table-condensed">
                    <tr>
                        <th>Ref No</th>
                        <th>Total</th>
                        <th>Status</th>
                    </tr>
                    {{range .PageData.Data.RecentTransfers}}
                    <tr>
                        <td>{{.RefNo}}</td>
                        <td>{{$.CurrencySymbol}}{{printf "%.2f" .FinalTotal}}</td>
                        <td><span class="label label-warning">{{.Status}}</span></td>
                    </tr>
                    {{else}}
                    <tr><td colspan="3" class="text-center">No recent transfers</td></tr>
                    {{end}}
                </table>
            </div>
            <div class="box-footer text-center">
                <a href="/stock-transfers" class="uppercase">View All Transfers</a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h3 class="box-title">Pending Orders</h3>
            </div>
            <div class="box-body no-padding">
                <table class="table table-condensed">
                    <tr>
                        <th>Invoice</th>
                        <th>Total</th>
                        <th>Status</th>
                    </tr>
                    {{range .PageData.Data.PendingOrders}}
                    <tr>
                        <td>{{.InvoiceNo}}</td>
                        <td>{{$.CurrencySymbol}}{{printf "%.2f" .FinalTotal}}</td>
                        <td><span class="label label-primary">{{.Status}}</span></td>
                    </tr>
                    {{else}}
                    <tr><td colspan="3" class="text-center">No pending orders</td></tr>
                    {{end}}
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Tables Row 3: Pending Invoices -->
<div class="row">
    <div class="col-md-12">
        <div class="box box-danger">
            <div class="box-header with-border">
                <h3 class="box-title">Pending Invoices</h3>
            </div>
            <div class="box-body no-padding">
                <table class="table table-condensed">
                    <tr>
                        <th>Invoice</th>
                        <th>Total</th>
                        <th>Payment Status</th>
                        <th>Date</th>
                    </tr>
                    {{range .PageData.Data.PendingInvoices}}
                    <tr>
                        <td>{{.InvoiceNo}}</td>
                        <td>{{$.CurrencySymbol}}{{printf "%.2f" .FinalTotal}}</td>
                        <td><span class="label label-danger">{{.PaymentStatus}}</span></td>
                        <td>{{.TransactionDate.Format "Jan 02, 2006"}}</td>
                    </tr>
                    {{else}}
                    <tr><td colspan="4" class="text-center">No pending invoices</td></tr>
                    {{end}}
                </table>
            </div>
        </div>
    </div>
</div>

{{end}}

{{define "scripts"}}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const ctx = document.getElementById('salesChart').getContext('2d');
        
        const labels = [
            {{range .PageData.Data.MonthlySales}}
            "{{.Date}}",
            {{end}}
        ];
        
        const data = [
            {{range .PageData.Data.MonthlySales}}
            {{.Total}},
            {{end}}
        ];

        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Daily Sales',
                    data: data,
                    borderColor: 'rgba(60,141,188,0.8)',
                    backgroundColor: 'rgba(60,141,188,0.1)',
                    fill: true,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return '{{.CurrencySymbol}}' + value;
                            }
                        }
                    }
                }
            }
        });
    });
</script>
{{end}}
