{{define "title"}}Brands{{end}}

{{define "header"}}Brands{{end}}
{{define "subheader"}}Manage product brands{{end}}

{{define "main"}}
<div class="row">
    <div class="col-md-12">
        <div class="box box-primary">
            <div class="box-header">
                <h3 class="box-title">All Brands</h3>
                <div class="box-tools">
                    <button type="button" class="btn btn-primary btn-sm" data-toggle="modal" data-target="#add_brand_modal">
                        <i class="fa fa-plus"></i> Add New Brand
                    </button>
                </div>
            </div>
            
            <div class="box-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped datatable" id="brands_table">
                        <thead>
                            <tr>
                                <th>Brand Name</th>
                                <th>Description</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{range .PageData.Brands}}
                            <tr>
                                <td>{{.Name}}</td>
                                <td>{{.Description}}</td>
                                <td>
                                    <div class="btn-group">
                                        <button class="btn btn-xs btn-primary edit_brand" data-id="{{.ID}}" data-name="{{.Name}}" data-description="{{.Description}}"><i class="glyphicon glyphicon-edit"></i> Edit</button>
                                        <button class="btn btn-xs btn-danger delete_brand" data-id="{{.ID}}"><i class="glyphicon glyphicon-trash"></i> Delete</button>
                                    </div>
                                </td>
                            </tr>
                            {{end}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add Brand Modal -->
<div class="modal fade" id="add_brand_modal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form id="brand_add_form" action="/brands/store" method="POST">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Add Brand</h4>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label for="name">Brand Name:*</label>
                        <input type="text" name="name" class="form-control" placeholder="Enter brand name" required>
                    </div>
                    <div class="form-group">
                        <label for="description">Description:</label>
                        <textarea name="description" class="form-control" rows="3" placeholder="Enter description"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Save Brand</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Brand Modal -->
<div class="modal fade" id="edit_brand_modal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form id="brand_edit_form">
                <input type="hidden" name="id" id="edit_brand_id">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Edit Brand</h4>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label for="edit_name">Brand Name:*</label>
                        <input type="text" name="name" id="edit_brand_name" class="form-control" placeholder="Enter brand name" required>
                    </div>
                    <div class="form-group">
                        <label for="edit_description">Description:</label>
                        <textarea name="description" id="edit_brand_description" class="form-control" rows="3" placeholder="Enter description"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary">Update Brand</button>
                </div>
            </form>
        </div>
    </div>
</div>
{{end}}

{{define "scripts"}}
<script type="text/javascript">
    document.addEventListener('DOMContentLoaded', function() {
        console.log("Brands page ready.");

        // Open edit modal
        $('.edit_brand').on('click', function() {
            var id = $(this).data('id');
            var name = $(this).data('name');
            var desc = $(this).data('description');
            
            $('#edit_brand_id').val(id);
            $('#edit_brand_name').val(name);
            $('#edit_brand_description').val(desc);
            
            $('#edit_brand_modal').modal('show');
        });

        // Handle edit form submit
        $('#brand_edit_form').on('submit', function(e) {
            e.preventDefault();
            var data = $(this).serialize();
            $.post('/api/brands/update', data, function(res) {
                if (res.success) {
                    $('#edit_brand_modal').modal('hide');
                    toastr.success('Brand updated successfully');
                    setTimeout(function() { window.location.reload(); }, 1000);
                } else {
                    toastr.error('Failed to update brand: ' + res.message);
                }
            }).fail(function() {
                toastr.error('Network error occurred.');
            });
        });

        // Handle delete
        $('.delete_brand').on('click', function() {
            var id = $(this).data('id');
            if (confirm("Are you sure you want to delete this brand?")) {
                $.post('/api/brands/delete', {id: id}, function(res) {
                    if (res.success) {
                        toastr.success('Brand deleted successfully');
                        setTimeout(function() { window.location.reload(); }, 1000);
                    } else {
                        toastr.error('Failed to delete brand: ' + res.message);
                    }
                }).fail(function() {
                    toastr.error('Network error occurred.');
                });
            }
        });
    });
</script>
{{end}}
