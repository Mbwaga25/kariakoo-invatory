{{define "title"}}Create Order{{end}}
{{define "header"}}Place New Order{{end}}
{{define "subheader"}}{{if eq .PageData.OrderType "BulkOrder"}}Bulk Order (External Customer){{else}}Store Order (Request Stock){{end}}{{end}}

{{define "main"}}
<div class="row">
    <!-- Order Form -->
    <div class="col-md-8">
        <div class="box {{if eq .PageData.OrderType "BulkOrder"}}box-info{{else}}box-success{{end}}">
            <div class="box-header with-border">
                <h3 class="box-title">
                    {{if eq .PageData.OrderType "BulkOrder"}}
                    <i class="fa fa-boxes"></i> BULK ORDER
                    {{else}}
                    <i class="fa fa-cart-plus"></i> STORE ORDER
                    {{end}}
                </h3>
            </div>
            <form action="/orders/store" method="POST" id="orderForm">
                <input type="hidden" name="order_type" value="{{.PageData.OrderType}}">
                <div class="box-body">
                    {{if eq .PageData.OrderType "BulkOrder"}}
                    <div class="form-group">
                        <label><i class="fa fa-user"></i> Customer Name:*</label>
                        <div class="input-group">
                            <select name="order_from" id="customerSelect" class="form-control" required>
                                <option value="">-- Select or Type New Customer --</option>
                                {{range .PageData.Customers}}
                                <option value="{{.Name}}">{{.Name}}</option>
                                {{end}}
                            </select>
                            <span class="input-group-btn">
                                <button type="button" class="btn btn-default" data-toggle="modal" data-target="#quickAddCustomerModal" title="Add New Customer">
                                    <i class="fa fa-plus-circle text-primary"></i>
                                </button>
                            </span>
                        </div>
                        <small class="help-block">e.g. "Ali Mobile" - the customer ordering from you</small>
                    </div>
                    {{end}}

                    <!-- Product Items -->
                    <div style="background:#F8FAFC;border-radius:8px;padding:15px;margin-top:10px;">
                        <h4 style="margin-top:0;color:#1B2A4A;"><i class="fa fa-list"></i> Order Items</h4>
                        
                        <div class="form-group" style="margin-bottom:20px;">
                            <label><i class="fa fa-search"></i> Add Product:</label>
                            <select id="smartProductSelect" class="form-control" style="border-color:#2E7D32;border-width:2px;">
                                <option value="">-- Search and Select a Product --</option>
                                {{range .PageData.Products}}
                                <option value="{{.ID}}" data-sku="{{.SKU}}" data-name="{{.Name}}" data-type="{{.ProductType}}" data-category="{{.CategoryName}}" data-brand="{{.BrandName}}">
                                    {{.ProductType}} | {{.CategoryName}} | {{.BrandName}} — {{.Name}} ({{.SKU}})
                                </option>
                                {{end}}
                            </select>
                            <small class="help-block" style="color:#666;">Select product → set quantity. Same product increments qty.</small>
                        </div>

                        <div id="orderItems">
                            <!-- Items added dynamically -->
                        </div>
                    </div>

                    <div class="form-group" style="margin-top:15px;">
                        <label>Notes:</label>
                        <textarea name="notes" class="form-control" rows="2" placeholder="Optional notes..."></textarea>
                    </div>

                    {{if eq .PageData.OrderType "BulkOrder"}}
                    <!-- Payment Information - Only for Bulk Orders -->
                    <div style="background:#FFF9C4;border-radius:8px;padding:15px;margin-top:15px;border:1px solid #FFD54F;">
                        <h4 style="margin-top:0;color:#1B2A4A;"><i class="fa fa-money-bill-wave"></i> Payment Information</h4>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>Payment Status:</label>
                                    <select name="payment_status" id="paymentStatus" class="form-control" required>
                                        <option value="unpaid">Not Paid Yet</option>
                                        <option value="paid">Fully Paid</option>
                                        <option value="incomplete">Partially Paid</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6" id="amountPaidGroup" style="display:none;">
                                <div class="form-group">
                                    <label>Amount Paid Now:</label>
                                    <div class="input-group">
                                        <span class="input-group-addon">{{.CurrencySymbol}}</span>
                                        <input type="number" name="amount_paid" id="amountPaidInput" class="form-control" step="0.01" min="0" value="0">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    {{end}}
                </div>
                <div class="box-footer" style="background:#F0F4F8;">
                    <div class="row">
                        <div class="col-md-6">
                            <h4 style="margin:5px 0;color:#1B2A4A;">Total Items: <span id="totalItemCount" style="color:#2E7D32;font-size:22px;">0</span></h4>
                        </div>
                        <div class="col-md-6 text-right">
                            <a href="/orders" class="btn btn-default" style="margin-right:10px;">Cancel</a>
                            <button type="submit" class="btn btn-primary btn-lg" style="min-width:200px;">
                                <i class="fa fa-check-circle"></i> 
                                {{if eq .PageData.OrderType "BulkOrder"}}Place Bulk Order{{else}}Place Store Order{{end}}
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Quick Switch Panel -->
    <div class="col-md-4">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h3 class="box-title"><i class="fa fa-exchange-alt"></i> Order Type</h3>
            </div>
            <div class="box-body">
                <a href="/orders/create?type=StoreOrder" class="btn btn-block {{if eq .PageData.OrderType "StoreOrder"}}btn-primary{{else}}btn-default{{end}}" style="margin-bottom:10px;padding:15px;text-align:left;">
                    <i class="fa fa-store" style="font-size:20px;margin-right:10px;"></i>
                    <strong>Store Order</strong><br>
                    <small style="opacity:0.8;">Request stock from store keeper</small>
                </a>
                <a href="/orders/create?type=BulkOrder" class="btn btn-block {{if eq .PageData.OrderType "BulkOrder"}}btn-info{{else}}btn-default{{end}}" style="padding:15px;text-align:left;">
                    <i class="fa fa-boxes" style="font-size:20px;margin-right:10px;"></i>
                    <strong>Bulk Order</strong><br>
                    <small style="opacity:0.8;">External customer orders</small>
                </a>
            </div>
        </div>

        <!-- How It Works -->
        <div class="box box-warning">
            <div class="box-header with-border">
                <h3 class="box-title"><i class="fa fa-info-circle"></i> How It Works</h3>
            </div>
            <div class="box-body" style="font-size:13px;">
                {{if eq .PageData.OrderType "BulkOrder"}}
                <ol style="padding-left:20px;">
                    <li style="margin-bottom:8px;">Enter customer name (e.g. "Ali Mobile")</li>
                    <li style="margin-bottom:8px;">Select products and total quantity</li>
                    <li style="margin-bottom:8px;">Set how many from <b>Shop</b> vs <b>Store</b></li>
                    <li style="margin-bottom:8px;"><b>From Store</b> items → need Store Keeper approval</li>
                    <li style="margin-bottom:8px;"><b>From Shop</b> items → just recorded as numbers</li>
                    <li>Track payment: Paid / Unpaid / Incomplete</li>
                </ol>
                {{else}}
                <ol style="padding-left:20px;">
                    <li style="margin-bottom:8px;">Select products and quantities</li>
                    <li style="margin-bottom:8px;">Submit the order</li>
                    <li style="margin-bottom:8px;">Store Keeper receives & reviews</li>
                    <li style="margin-bottom:8px;">✅ Accept → stock reduces automatically</li>
                    <li>❌ Reject → you get notified</li>
                </ol>
                {{end}}
            </div>
        </div>
    </div>
</div>

<!-- Quick Add Customer Modal -->
<div class="modal fade" id="quickAddCustomerModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Add New Customer</h4>
            </div>
            <form id="quickAddCustomerForm">
                <input type="hidden" name="type" value="customer">
                <div class="modal-body">
                    <div class="form-group">
                        <label>Customer Name:*</label>
                        <input type="text" name="name" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Mobile Number:</label>
                        <input type="text" name="mobile" class="form-control">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary" id="saveCustomerBtn">Save Customer</button>
                </div>
            </form>
        </div>
    </div>
</div>
{{end}}

{{define "scripts"}}
<script>
$(document).ready(function() {
    var currency = '{{.CurrencySymbol}}';
    var orderType = '{{.PageData.OrderType}}';
    var itemCount = 0;

    function updateItemCount() {
        itemCount = $('#orderItems .order-item').length;
        $('#totalItemCount').text(itemCount);
    }

    $('#smartProductSelect').change(function() {
        var opt = $(this).find('option:selected');
        var id = opt.val();
        if (!id) return;

        var sku = opt.data('sku');
        var name = opt.data('name');
        var ptype = opt.data('type') || '';
        var category = opt.data('category') || '';
        var brand = opt.data('brand') || '';
        
        // Check if exists
        var existingRow = $('#row-' + id);
        if (existingRow.length > 0) {
            var qtyInput = existingRow.find('.qty-input');
            qtyInput.val(parseInt(qtyInput.val()) + 1).trigger('input');
        } else {
            var displayName = ptype + ' — ' + category + ' — ' + brand;
            if (!category && !brand) displayName = name;

            var extraCols = '';
            if (orderType === 'BulkOrder') {
                extraCols = 
                    '<div class="col-md-2"><label class="text-xs" style="font-size:10px;color:#666;">From Shop:</label>' +
                    '<input type="number" name="from_shop_qty[]" class="form-control input-sm shop-qty text-center" min="0" value="0"></div>' +
                    '<div class="col-md-2"><label class="text-xs" style="font-size:10px;color:#666;">From Store:</label>' +
                    '<input type="number" name="from_store_qty[]" class="form-control input-sm store-qty text-center" min="0" value="1"></div>';
            }

            var qtyColSize = orderType === 'BulkOrder' ? '3' : '4';
            
            var html = '<div class="order-item row" id="row-'+id+'" style="margin-bottom:10px; background:#fff; padding:10px; border-radius:5px; border:1px solid #ddd;">' +
                '<input type="hidden" name="product_id[]" value="'+id+'">' +
                '<div class="col-md-' + (orderType === 'BulkOrder' ? '4' : '6') + '"><p style="margin:5px 0;font-weight:bold;">'+displayName+'</p><small style="color:#888;">SKU: '+sku+'</small></div>' +
                '<div class="col-md-'+qtyColSize+'"><label class="text-xs" style="font-size:10px;color:#666;">Total Qty:</label><div class="input-group"><span class="input-group-btn"><button type="button" class="btn btn-default btn-sm qty-minus"><i class="fa fa-minus"></i></button></span><input type="number" name="quantity[]" class="form-control input-sm qty-input text-center" min="1" value="1" required><span class="input-group-btn"><button type="button" class="btn btn-default btn-sm qty-plus"><i class="fa fa-plus"></i></button></span></div></div>' +
                extraCols +
                '<div class="col-md-1"><button type="button" class="btn btn-danger btn-sm remove-item" title="Remove" style="margin-top:18px;"><i class="fa fa-trash"></i></button></div>' +
                '</div>';
            $('#orderItems').append(html);
        }
        
        updateItemCount();
        $(this).val(''); // reset
    });

    $(document).on('click', '.qty-minus', function() {
        var input = $(this).closest('.input-group').find('.qty-input');
        var val = parseInt(input.val());
        if (val > 1) {
            input.val(val - 1).trigger('input');
        }
    });

    $(document).on('click', '.qty-plus', function() {
        var input = $(this).closest('.input-group').find('.qty-input');
        input.val(parseInt(input.val()) + 1).trigger('input');
    });

    // Auto-split: when total qty changes, update from_store_qty to match
    $(document).on('input change', '.qty-input', function() {
        if (orderType === 'BulkOrder') {
            var row = $(this).closest('.order-item');
            var totalQty = parseInt($(this).val()) || 0;
            var shopQty = parseInt(row.find('.shop-qty').val()) || 0;
            row.find('.store-qty').val(Math.max(0, totalQty - shopQty));
        }
        updateItemCount();
    });

    // When shop qty changes, adjust store qty
    $(document).on('input change', '.shop-qty', function() {
        var row = $(this).closest('.order-item');
        var totalQty = parseInt(row.find('.qty-input').val()) || 0;
        var shopQty = parseInt($(this).val()) || 0;
        if (shopQty > totalQty) {
            $(this).val(totalQty);
            shopQty = totalQty;
        }
        row.find('.store-qty').val(Math.max(0, totalQty - shopQty));
    });

    // When store qty changes, adjust shop qty
    $(document).on('input change', '.store-qty', function() {
        var row = $(this).closest('.order-item');
        var totalQty = parseInt(row.find('.qty-input').val()) || 0;
        var storeQty = parseInt($(this).val()) || 0;
        if (storeQty > totalQty) {
            $(this).val(totalQty);
            storeQty = totalQty;
        }
        row.find('.shop-qty').val(Math.max(0, totalQty - storeQty));
    });

    $(document).on('click', '.remove-item', function() {
        $(this).closest('.order-item').remove();
        updateItemCount();
    });

    // Payment Status handling (Bulk Order only)
    $('#paymentStatus').change(function() {
        var status = $(this).val();
        if (status === 'unpaid') {
            $('#amountPaidGroup').hide();
            $('#amountPaidInput').val(0);
        } else {
            $('#amountPaidGroup').show();
            if (status === 'paid') {
                $('#amountPaidInput').val('').prop('readonly', false);
            } else {
                $('#amountPaidInput').val('').prop('readonly', false).focus();
            }
        }
    });

    // Make select2 for better search if available
    if($.fn.select2) {
        $('#smartProductSelect').select2({ width: '100%' });
        $('#customerSelect').select2({
            width: '100%',
            tags: true,
            placeholder: "-- Select or Type New Customer --",
            allowClear: true
        });
    }

    // Quick Add Customer AJAX
    $('#quickAddCustomerForm').on('submit', function(e) {
        e.preventDefault();
        var btn = $('#saveCustomerBtn');
        btn.prop('disabled', true).text('Saving...');

        $.ajax({
            url: '/api/contacts/store',
            method: 'POST',
            data: $(this).serialize(),
            success: function(res) {
                if (res.success === "true") {
                    var newOption = new Option(res.name, res.name, true, true);
                    $('#customerSelect').append(newOption).trigger('change');
                    
                    $('#quickAddCustomerModal').modal('hide');
                    $('#quickAddCustomerForm')[0].reset();
                } else {
                    toastr.error('Error: ' + res.msg);
                }
            },
            error: function() {
                toastr.error('Connection error. Please try again.');
            },
            complete: function() {
                btn.prop('disabled', false).text('Save Customer');
            }
        });
    });
});
</script>
{{end}}

{{define "styles"}}
<style>
    .select2-container--default .select2-selection--single {
        height: 34px !important;
        border: 1px solid #ccc !important;
    }
</style>
{{end}}
