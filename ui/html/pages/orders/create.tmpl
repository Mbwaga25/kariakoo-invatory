        border: 1px solid #ffd54f;
    }

    body.legacy-order-create .order-create-page .footer-summary {
        background: #f0f4f8;
    }

    body.legacy-order-create .order-create-page .order-type-card .btn {
        height: auto;
        padding: 15px;
        text-align: left;
        white-space: normal;
