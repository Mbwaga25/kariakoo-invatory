    }

    body.legacy-order-create .order-create-page .btn-default {
        background-color: #f4f4f4;
        border-color: #ddd;
        color: #444;
    }

    body.legacy-order-create .order-create-page .btn-primary {
        background-color: #3c8dbc;
        border-color: #367fa9;
        color: #fff;
    }

    body.legacy-order-create .order-create-page .btn-success {
        background-color: #00a65a;
        border-color: #008d4c;
        color: #fff;
    }

    body.legacy-order-create .order-create-page .btn-info {
        background-color: #00c0ef;
