{{define "title"}}Pending Orders{{end}}
{{define "header"}}Incoming Orders{{end}}
{{define "subheader"}}Orders waiting for your action{{end}}

{{define "main"}}
<div class="row">
    <div class="col-md-12">
        {{if .PageData.Orders}}
        <div class="row">
            {{range .PageData.Orders}}
            <div class="col-md-6">
                <div class="box box-warning" style="border-left:5px solid #F9A825;">
                    <div class="box-header with-border">
                        <h3 class="box-title"><i class="fa fa-bell"></i> New Order Received</h3>
                        <div class="box-tools pull-right">
                            <span class="badge-pending">PENDING</span>
                        </div>
                    </div>
                    <div class="box-body">
                        <table class="table table-condensed" style="margin:0;">
                            <tr><td style="color:#888;width:40%;">Order Type</td><td><strong>{{if eq .OrderType "StoreOrder"}}Store Order{{else}}Bulk Order{{end}}</strong></td></tr>
                            <tr><td style="color:#888;">Ref No</td><td><strong>{{.RefNo}}</strong></td></tr>
                            <tr><td style="color:#888;">From</td><td>{{.PlacedByName}} {{if .OrderFrom}}/ {{.OrderFrom}}{{end}}</td></tr>
                            <tr><td style="color:#888;">Total</td><td style="font-size:18px;font-weight:700;color:#1B2A4A;">{{$.CurrencySymbol}} {{printf "%.2f" .TotalAmount}}</td></tr>
                            <tr><td style="color:#888;">Date</td><td>{{.CreatedAt.Format "Jan 02, 2006 3:04 PM"}}</td></tr>
                        </table>
                    </div>
                    <div class="box-footer" style="background:#f9f9f9;">
                        <div class="row">
                            <div class="col-xs-4">
                                <a href="/orders/view?id={{.ID}}" class="btn btn-default btn-block" style="border:1px solid #ccc;"><i class="fa fa-eye"></i> View Details</a>
                            </div>
                            <div class="col-xs-4">
                                <form action="/orders/accept" method="POST" style="display:inline;">
                                    <input type="hidden" name="order_id" value="{{.ID}}">
                                    <input type="hidden" name="amount_paid" value="0">
                                    <button type="submit" class="btn btn-success btn-block" onclick="return confirm('Accept this order? Stock will be reduced.')">
                                        <i class="fa fa-check"></i> Accept
                                    </button>
                                </form>
                            </div>
                            <div class="col-xs-4">
                                <form action="/orders/reject" method="POST" id="rejectForm_{{.ID}}" style="display:inline;">
                                    <input type="hidden" name="order_id" value="{{.ID}}">
                                    <input type="hidden" name="reason" id="rejectReason_{{.ID}}" value="Rejected from list">
                                    <button type="button" class="btn btn-danger btn-block" onclick="var r = prompt('Reason for rejection?'); if(r){ document.getElementById('rejectReason_{{.ID}}').value = r; document.getElementById('rejectForm_{{.ID}}').submit(); }">
                                        <i class="fa fa-times"></i> Reject
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            {{end}}
        </div>
        {{else}}
        <div class="box">
            <div class="box-body text-center" style="padding:60px;">
                <i class="fa fa-inbox" style="font-size:60px;color:#ccc;"></i>
                <h3 style="color:#888;">No Pending Orders</h3>
                <p style="color:#aaa;">All orders have been processed. Check back later.</p>
            </div>
        </div>
        {{end}}
    </div>
</div>
{{end}}
