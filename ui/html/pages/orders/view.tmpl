{{define "title"}}Order {{.PageData.Order.RefNo}}{{end}}
{{define "header"}}Order Details{{end}}
{{define "subheader"}}{{.PageData.Order.RefNo}}{{end}}

{{define "main"}}
<div class="row">
    <!-- Order Details -->
    <div class="col-md-8">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h3 class="box-title"><i class="fa fa-clipboard-list"></i> Order #{{.PageData.Order.RefNo}}</h3>
                <div class="box-tools pull-right">
                    <span class="badge-{{.PageData.Order.Status}}" style="font-size:14px;">{{.PageData.Order.Status}}</span>
                </div>
            </div>
            <div class="box-body">
                <!-- Order Info Grid -->
                <div class="row" style="margin-bottom:20px;">
                    <div class="col-md-4">
                        <p style="margin:3px 0;color:#888;font-size:12px;">ORDER TYPE</p>
                        <p style="font-weight:700;font-size:15px;">
                            {{if eq .PageData.Order.OrderType "StoreOrder"}}
                            <span class="label" style="background:#2E7D32;font-size:13px;"><i class="fa fa-store"></i> Store Order</span>
                            {{else}}
                            <span class="label" style="background:#0277BD;font-size:13px;"><i class="fa fa-boxes"></i> Bulk Order</span>
                            {{end}}
                        </p>
                    </div>
                    <div class="col-md-4">
                        <p style="margin:3px 0;color:#888;font-size:12px;">PLACED BY</p>
                        <p style="font-weight:700;font-size:15px;">{{.PageData.Order.PlacedByName}}</p>
                    </div>
                    <div class="col-md-4">
                        <p style="margin:3px 0;color:#888;font-size:12px;">DATE</p>
                        <p style="font-weight:700;font-size:15px;">{{.PageData.Order.CreatedAt.Format "Jan 02, 2006 15:04"}}</p>
                    </div>
                </div>
                {{if eq .PageData.Order.OrderType "StoreOrder"}}
                <div class="row" style="margin-bottom:20px;">
                    <div class="col-md-4">
                        <p style="margin:3px 0;color:#888;font-size:12px;">SOURCE (FROM)</p>
                        <p style="font-weight:700;font-size:15px;color:#C62828;"><i class="fa fa-map-marker-alt"></i> {{.PageData.Order.FromLocationName}}</p>
                    </div>
                    <div class="col-md-4">
                        <p style="margin:3px 0;color:#888;font-size:12px;">DESTINATION (TO)</p>
                        <p style="font-weight:700;font-size:15px;color:#2E7D32;"><i class="fa fa-map-pin"></i> {{.PageData.Order.ToLocationName}}</p>
                    </div>
                </div>
                {{end}}

                {{if .PageData.Order.OrderFrom}}
                <div class="row" style="margin-bottom:20px;">
                    <div class="col-md-4">
                        <p style="margin:3px 0;color:#888;font-size:12px;">CUSTOMER</p>
                        <p style="font-weight:700;"><i class="fa fa-user"></i> {{.PageData.Order.OrderFrom}}</p>
                    </div>
                </div>
                {{end}}

                <!-- Order Items Table -->
                <h4 style="color:#1B2A4A;border-bottom:2px solid #1B2A4A;padding-bottom:8px;"><i class="fa fa-list"></i> Items</h4>
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Type</th>
                            <th class="text-center">Total Qty</th>
                            {{if eq .PageData.Order.OrderType "BulkOrder"}}
                            <th class="text-center" style="background:#E8F5E9;">From Shop</th>
                            <th class="text-center" style="background:#E3F2FD;">From Store</th>
                            {{end}}
                        </tr>
                    </thead>
                    <tbody>
                        {{range .PageData.Order.Items}}
                        <tr>
                            <td>
                                <strong>{{.ProductName}}</strong><br>
                                <small class="text-muted">{{.CategoryName}} | {{.BrandName}} — SKU: {{.ProductSKU}}</small>
                            </td>
                            <td>
                                {{if eq .ProductType "Protector"}}
                                <span class="label" style="background:#2E7D32;"><i class="fa fa-shield-alt"></i></span>
                                {{else}}
                                <span class="label" style="background:#0277BD;"><i class="fa fa-mobile-alt"></i></span>
                                {{end}}
                            </td>
                            <td class="text-center" style="font-size:16px;font-weight:bold;">{{printf "%.0f" .Quantity}}</td>
                            {{if eq $.PageData.Order.OrderType "BulkOrder"}}
                            <td class="text-center" style="background:#F1F8E9;">
                                {{if gt .FromShopQty 0.0}}
                                <span style="font-weight:bold;">{{printf "%.0f" .FromShopQty}}</span>
                                <br><small class="text-muted">just recorded</small>
                                {{else}}—{{end}}
                            </td>
                            <td class="text-center" style="background:#E8EAF6;">
                                {{if gt .FromStoreQty 0.0}}
                                <span style="font-weight:bold;color:#0277BD;">{{printf "%.0f" .FromStoreQty}}</span>
                                <br><small class="text-muted">stock deducted</small>
                                {{else}}—{{end}}
                            </td>
                            {{end}}
                        </tr>
                        {{else}}
                        <tr><td colspan="5" class="text-center">No items</td></tr>
                        {{end}}
                    </tbody>
                </table>

                {{if .PageData.Order.Notes}}
                <div style="background:#FFF9C4;padding:12px;border-radius:8px;margin-top:15px;white-space:pre-wrap;">
                    <strong><i class="fa fa-sticky-note"></i> Notes:</strong> {{.PageData.Order.Notes}}
                </div>
                {{end}}
            </div>

            <!-- Accept/Reject Actions (Store Keeper & Admins) -->
            {{if and (eq .PageData.Order.Status "pending") (or (eq .PageData.UserRole "StoreKeeper") (eq .PageData.UserRole "SuperAdmin") (eq .PageData.UserRole "ShopAdmin"))}}
            <div class="box-footer" style="background:#F0F4F8;padding:20px;">
                <h4 style="margin-top:0;color:#1B2A4A;"><i class="fa fa-gavel"></i> Process Order</h4>
                
                <div class="row">
                    <div class="col-md-7">
                        <form action="/orders/accept" method="POST" style="background:#fff; padding:15px; border-radius:8px; border:2px solid #2E7D32;">
                            <input type="hidden" name="order_id" value="{{.PageData.Order.ID}}">
                            
                            <p style="color:#2E7D32;font-weight:bold;font-size:15px;"><i class="fa fa-check-circle"></i> Accept Order</p>
                            <p class="text-muted" style="font-size:12px;">
                                {{if eq .PageData.Order.OrderType "BulkOrder"}}
                                Stock will be deducted for "From Store" items only. "From Shop" items are just recorded.
                                {{else}}
                                Stock will be deducted from your store location automatically.
                                {{end}}
                            </p>
                            <button type="submit" class="btn btn-success btn-block btn-lg" style="font-weight:bold;">
                                <i class="fa fa-check"></i> ACCEPT ORDER
                            </button>
                        </form>
                    </div>
                    
                    <div class="col-md-5">
                        <form action="/orders/reject" method="POST" style="background:#fff; padding:15px; border-radius:8px; border:2px solid #C62828;">
                            <input type="hidden" name="order_id" value="{{.PageData.Order.ID}}">
                            
                            <p style="color:#C62828;font-weight:bold;"><i class="fa fa-times-circle"></i> Reject Order</p>
                            <div class="form-group">
                                <textarea name="reason" class="form-control" rows="2" placeholder="Reason for rejection..." required></textarea>
                            </div>
                            <button type="submit" class="btn btn-danger btn-block" style="font-weight:bold;">
                                <i class="fa fa-times"></i> REJECT
                            </button>
                        </form>
                    </div>
                </div>
            </div>
            {{end}}

            {{if eq .PageData.Order.Status "accepted"}}
            <div class="box-footer" style="background:#E8F5E9;padding:15px;">
                <p style="color:#2E7D32;margin:0;"><i class="fa fa-check"></i> <strong>Order Accepted</strong> 
                    {{if .PageData.Order.ProcessedByName}}by {{.PageData.Order.ProcessedByName}}{{end}}
                    — Stock has been updated.</p>
            </div>
            {{end}}

            {{if eq .PageData.Order.Status "rejected"}}
            <div class="box-footer" style="background:#FFEBEE;padding:15px;">
                <p style="color:#C62828;margin:0;"><i class="fa fa-times"></i> <strong>Order Rejected</strong> 
                    {{if .PageData.Order.ProcessedByName}}by {{.PageData.Order.ProcessedByName}}{{end}}</p>
            </div>
            {{end}}
        </div>
    </div>

    <!-- Payment Panel (Bulk Orders only) -->
    <div class="col-md-4">
        {{if eq .PageData.Order.OrderType "BulkOrder"}}
        <div class="box box-warning">
            <div class="box-header with-border" style="background:{{if eq .PageData.Order.PaymentStatus "paid"}}#E8F5E9{{else if eq .PageData.Order.PaymentStatus "incomplete"}}#FFF3E0{{else}}#FFEBEE{{end}};border-radius:12px 12px 0 0;">
                <h3 class="box-title"><i class="fa fa-credit-card"></i> Payment Status</h3>
            </div>
            <div class="box-body text-center" style="padding:25px;">
                <div style="margin-bottom:20px;">
                    {{if eq .PageData.Order.PaymentStatus "paid"}}
                    <i class="fa fa-check-circle" style="font-size:50px;color:#2E7D32;"></i>
                    <h3 style="color:#2E7D32;margin:10px 0 0;">Paid</h3>
                    {{else if eq .PageData.Order.PaymentStatus "incomplete"}}
                    <i class="fa fa-exclamation-circle" style="font-size:50px;color:#E65100;"></i>
                    <h3 style="color:#E65100;margin:10px 0 0;">Incomplete</h3>
                    {{else}}
                    <i class="fa fa-times-circle" style="font-size:50px;color:#C62828;"></i>
                    <h3 style="color:#C62828;margin:10px 0 0;">Unpaid</h3>
                    {{end}}
                </div>

                <table class="table" style="margin-bottom:0;">
                    <tr><td style="text-align:left;color:#888;">Amount Paid</td><td style="text-align:right;font-weight:700;color:#2E7D32;">{{.CurrencySymbol}} {{printf "%.2f" .PageData.Order.AmountPaid}}</td></tr>
                    <tr><td style="text-align:left;color:#888;">Remaining</td><td style="text-align:right;font-weight:700;color:#C62828;">{{.CurrencySymbol}} {{printf "%.2f" .PageData.Order.RemainingAmount}}</td></tr>
                </table>
            </div>

            {{if and (ne .PageData.Order.PaymentStatus "paid") (ne .PageData.Order.Status "rejected")}}
            <div class="box-footer">
                <h4 style="margin-top:0;color:#1B2A4A;"><i class="fa fa-money-bill"></i> Record Payment</h4>
                <form action="/orders/payment" method="POST">
                    <input type="hidden" name="order_id" value="{{.PageData.Order.ID}}">
                    <div class="form-group">
                        <label>Amount Paid:</label>
                        <div class="input-group">
                            <span class="input-group-addon">{{.CurrencySymbol}}</span>
                            <input type="number" name="amount" class="form-control" step="0.01" min="0.01" required placeholder="Enter amount">
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block" style="background:#E65100;border-color:#E65100;">
                        <i class="fa fa-check"></i> Update Payment
                    </button>
                </form>
            </div>
            {{end}}
        </div>

        <!-- Payment History -->
        {{if .PageData.Payments}}
        <div class="box box-info">
            <div class="box-header with-border">
                <h3 class="box-title"><i class="fa fa-history"></i> Payment History</h3>
            </div>
            <div class="box-body no-padding">
                <table class="table table-condensed">
                    <tr><th>Amount</th><th>By</th><th>Date</th></tr>
                    {{range .PageData.Payments}}
                    <tr>
                        <td><strong>{{$.CurrencySymbol}} {{printf "%.2f" .Amount}}</strong></td>
                        <td>{{.PaidByName}}</td>
                        <td>{{.CreatedAt.Format "Jan 02"}}</td>
                    </tr>
                    {{end}}
                </table>
            </div>
        </div>
        {{end}}
        {{end}}

        <!-- Flow Status -->
        <div class="box box-success">
            <div class="box-header with-border">
                <h3 class="box-title"><i class="fa fa-check-double"></i> Order Flow</h3>
            </div>
            <div class="box-body" style="font-size:13px;">
                <ul style="list-style:none;padding:0;">
                    <li style="padding:5px 0;">
                        <i class="fa fa-check-circle" style="color:#2E7D32;margin-right:8px;"></i> 
                        Order Placed
                    </li>
                    <li style="padding:5px 0;">
                        <i class="fa fa-{{if ne .PageData.Order.Status "pending"}}check-circle{{else}}circle{{end}}" 
                           style="color:{{if ne .PageData.Order.Status "pending"}}#2E7D32{{else}}#ccc{{end}};margin-right:8px;"></i> 
                        {{if eq .PageData.Order.Status "accepted"}}Accepted by Store Keeper
                        {{else if eq .PageData.Order.Status "rejected"}}Rejected by Store Keeper
                        {{else}}Awaiting Store Keeper
                        {{end}}
                    </li>
                    <li style="padding:5px 0;">
                        <i class="fa fa-{{if or (eq .PageData.Order.Status "accepted") (eq .PageData.Order.Status "completed")}}check-circle{{else}}circle{{end}}" 
                           style="color:{{if or (eq .PageData.Order.Status "accepted") (eq .PageData.Order.Status "completed")}}#2E7D32{{else}}#ccc{{end}};margin-right:8px;"></i> 
                        Stock Updated
                    </li>
                    {{if eq .PageData.Order.OrderType "BulkOrder"}}
                    <li style="padding:5px 0;">
                        <i class="fa fa-{{if ne .PageData.Order.PaymentStatus "unpaid"}}check-circle{{else}}circle{{end}}" 
                           style="color:{{if ne .PageData.Order.PaymentStatus "unpaid"}}#2E7D32{{else}}#ccc{{end}};margin-right:8px;"></i> 
                        Payment Tracked
                    </li>
                    {{end}}
                </ul>
            </div>
        </div>

        <a href="/orders/invoice?id={{.PageData.Order.ID}}" class="btn btn-info btn-block" style="background:#0277BD; border-color:#0277BD; font-weight:bold; margin-bottom:10px;"><i class="fa fa-file-invoice"></i> View/Print Invoice</a>
        <a href="/orders" class="btn btn-default btn-block"><i class="fa fa-arrow-left"></i> Back to Orders</a>
    </div>
</div>
{{end}}

{{define "scripts"}}
{{end}}
