{{define "title"}}Add New Stock{{end}}

{{define "header"}}Receive Stock{{end}}
{{define "subheader"}}Add new inventory from supplier delivery{{end}}

{{define "main"}}
<div class="box box-primary">
    <div class="box-header with-border">
        <h3 class="box-title"><i class="fa fa-download"></i> Stock Entry</h3>
        <p class="text-muted" style="margin:5px 0 0;">Record incoming stock — just select products, quantities, and which store to add them to.</p>
    </div>
    <form action="/purchases/store" method="POST">
        <div class="box-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="location_id"><i class="fa fa-map-marker"></i> Store Location:*</label>
                        <select name="location_id" id="location_id" class="form-control" required>
                            {{range .PageData.Locations}}
                            <option value="{{.ID}}">{{.Name}}</option>
                            {{end}}
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="ref_no"><i class="fa fa-hashtag"></i> Reference No:</label>
                        <input type="text" name="ref_no" class="form-control" id="ref_no" placeholder="Optional reference number">
                    </div>
                </div>
            </div>

            <hr>
            
            <div class="row">
                <div class="col-md-12">
                    <h4 class="box-title" style="margin-bottom: 15px;"><i class="fa fa-cubes"></i> Products to Add</h4>
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover" id="purchase_items_table">
                            <thead>
                                <tr class="bg-blue" style="color: white;">
                                    <th style="width: 55%">Product</th>
                                    <th style="width: 30%">Quantity</th>
                                    <th style="width: 15%" class="text-center">
                                        <button type="button" class="btn btn-success btn-sm" id="add_row" title="Add Product">
                                            <i class="fa fa-plus"></i>
                                        </button>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="product-row">
                                    <td>
                                        <select name="product_id[]" class="form-control" required style="width: 100%;">
                                            <option value="">-- Select Product --</option>
                                            {{range .PageData.Products}}
                                            <option value="{{.ID}}">{{.ProductType}} | {{.CategoryName}} | {{.BrandName}} — {{.Name}}</option>
                                            {{end}}
                                        </select>
                                    </td>
                                    <td>
                                        <div class="input-group">
                                            <input type="number" step="1" name="quantity[]" class="form-control" required placeholder="e.g. 500" min="1">
                                            <span class="input-group-addon">pcs</span>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-danger btn-sm remove-row-btn" style="display: none;">
                                            <i class="fa fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr class="bg-gray">
                                    <th class="text-right">Total Products: <span id="total_items">1</span></th>
                                    <th colspan="2">Total Quantity: <span id="total_qty" style="color:#2E7D32;font-weight:bold;">0</span></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <script>
            document.addEventListener('DOMContentLoaded', function() {
                const tableBody = document.querySelector('#purchase_items_table tbody');
                const addRowBtn = document.getElementById('add_row');
                
                function updateTotals() {
                    const rows = tableBody.querySelectorAll('tr');
                    document.getElementById('total_items').textContent = rows.length;
                    
                    let totalQty = 0;
                    rows.forEach(row => {
                        const qty = parseFloat(row.querySelector('input[name="quantity[]"]').value) || 0;
                        totalQty += qty;
                    });
                    document.getElementById('total_qty').textContent = totalQty.toLocaleString();
                }

                addRowBtn.addEventListener('click', function() {
                    const firstRow = tableBody.querySelector('tr');
                    const newRow = firstRow.cloneNode(true);
                    
                    // Clear values
                    newRow.querySelectorAll('input').forEach(input => {
                        input.value = '';
                        input.addEventListener('input', updateTotals);
                    });
                    
                    const select = newRow.querySelector('select');
                    select.selectedIndex = 0;
                    
                    // Show remove button
                    const removeBtn = newRow.querySelector('.remove-row-btn');
                    removeBtn.style.display = 'inline-block';
                    removeBtn.addEventListener('click', function() {
                        newRow.remove();
                        updateTotals();
                    });
                    
                    tableBody.appendChild(newRow);
                    updateTotals();
                });

                // Initial events
                tableBody.querySelectorAll('input').forEach(input => {
                    input.addEventListener('input', updateTotals);
                });
            });
        </script>

        <div class="box-footer">
            <button type="submit" class="btn btn-primary btn-lg"><i class="fa fa-save"></i> Save Stock Entry</button>
            <a href="/purchases" class="btn btn-default btn-lg">Cancel</a>
        </div>
    </form>
</div>
{{end}}
