{{define "title"}}Purchase Details{{end}}

{{define "header"}}Purchase Details{{end}}
{{define "subheader"}}Reference No: {{.PageData.Purchase.RefNo}}{{end}}

{{define "main"}}
<div class="row">
    <div class="col-md-12">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h3 class="box-title"><i class="fa fa-info-circle"></i> Purchase Information</h3>
                <div class="box-tools">
                    <a href="/purchases" class="btn btn-default btn-sm"><i class="fa fa-arrow-left"></i> Back to Purchases</a>
                </div>
            </div>
            <div class="box-body">
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Reference Number:</strong> {{.PageData.Purchase.RefNo}}</p>
                        <p><strong>Purchase Date:</strong> {{.PageData.Purchase.PurchaseDate.Format "Jan 02, 2006"}}</p>
                        <p><strong>Status:</strong> <span class="label label-info">{{.PageData.Purchase.Status}}</span></p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Payment Status:</strong> <span class="label label-success">{{.PageData.Purchase.PaymentStatus}}</span></p>
                        <p><strong>Location ID:</strong> {{.PageData.Purchase.BusinessLocationID}}</p>
                        <p><strong>Grand Total:</strong> TSh {{printf "%.2f" .PageData.Purchase.FinalTotal}}</p>
                    </div>
                </div>

                <hr>
                
                <h4><i class="fa fa-list"></i> Purchase Items</h4>
                <div class="table-responsive">
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>Product Name</th>
                                <th>SKU</th>
                                <th>Quantity</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{range .PageData.Purchase.Items}}
                            <tr>
                                <td>{{.ProductName}}</td>
                                <td><code>{{.SKU}}</code></td>
                                <td>{{.Quantity}}</td>
                            </tr>
                            {{else}}
                            <tr>
                                <td colspan="3" class="text-center">No items found for this purchase.</td>
                            </tr>
                            {{end}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{{end}}

{{define "scripts"}}
{{end}}
