{{define "title"}}Product Details{{end}}

{{define "header"}}Product Details{{end}}
{{define "subheader"}}View product information and stock levels{{end}}

{{define "main"}}
<div class="row">
    <div class="col-md-6">
        <div class="box box-primary">
            <div class="box-header with-border">
                <h3 class="box-title"><i class="fa fa-info-circle"></i> Product Information</h3>
                <div class="box-tools">
                    <a href="/products/edit?id={{.PageData.Product.ID}}" class="btn btn-primary btn-sm"><i class="fa fa-edit"></i> Edit</a>
                </div>
            </div>
            <div class="box-body">
                <table class="table table-bordered">
                    <tr>
                        <th style="width:35%;">Product Type</th>
                        <td>
                            {{if eq .PageData.Product.ProductType "Protector"}}
                            <span class="label" style="background:#2E7D32;font-size:13px;"><i class="fa fa-shield-alt"></i> Protector</span>
                            {{else}}
                            <span class="label" style="background:#0277BD;font-size:13px;"><i class="fa fa-mobile-alt"></i> Cover</span>
                            {{end}}
                        </td>
                    </tr>
                    <tr>
                        <th>Product Name</th>
                        <td><strong>{{.PageData.Product.Name}}</strong></td>
                    </tr>
                    <tr>
                        <th>SKU</th>
                        <td><code>{{.PageData.Product.SKU}}</code></td>
                    </tr>
                    <tr>
                        <th>Category (Type)</th>
                        <td>{{.PageData.Product.CategoryName}}</td>
                    </tr>
                    <tr>
                        <th>Phone Model</th>
                        <td>{{.PageData.Product.BrandName}}</td>
                    </tr>
                    <tr>
                        <th>Low Stock Alert</th>
                        <td>
                            {{if .PageData.Product.AlertQuantity}}
                            <span class="label label-warning">{{.PageData.Product.AlertQuantity}} pcs</span>
                            {{else}}
                            <span class="text-muted">Not set</span>
                            {{end}}
                        </td>
                    </tr>
                    {{if .PageData.Product.Description}}
                    <tr>
                        <th>Description</th>
                        <td>{{.PageData.Product.Description}}</td>
                    </tr>
                    {{end}}
                </table>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="box box-success">
            <div class="box-header with-border">
                <h3 class="box-title"><i class="fa fa-cubes"></i> Stock by Store</h3>
                {{if or (eq $.Role "StoreKeeper") (eq $.Role "SuperAdmin") (eq $.Role "ShopAdmin")}}
                <div class="box-tools">
                    <a href="/purchases/create?product_id={{.PageData.Product.ID}}" class="btn btn-success btn-sm"><i class="fa fa-download"></i> Add Stock</a>
                </div>
                {{end}}
            </div>
            <div class="box-body">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Store</th>
                            <th class="text-center">Quantity</th>
                            <th class="text-center">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{range .PageData.Stock}}
                        <tr>
                            <td>
                                <strong>{{.LocationName}}</strong>
                                {{if .City}}<br><small class="text-muted">{{.City}}</small>{{end}}
                            </td>
                            <td class="text-center" style="font-size:18px;font-weight:bold;">{{.Qty}}</td>
                            <td class="text-center">
                                {{if gt .Qty 50.0}}
                                <span class="label label-success"><i class="fa fa-check"></i> In Stock</span>
                                {{else if gt .Qty 0.0}}
                                <span class="label label-warning"><i class="fa fa-exclamation-triangle"></i> Low Stock</span>
                                {{else}}
                                <span class="label label-danger"><i class="fa fa-times"></i> Out of Stock</span>
                                {{end}}
                            </td>
                        </tr>
                        {{end}}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-12">
        <a href="/products" class="btn btn-default"><i class="fa fa-arrow-left"></i> Back to Products</a>
    </div>
</div>
{{end}}
