{{define "title"}}Product Details{{end}}

{{define "header"}}Product Details{{end}}
{{define "subheader"}}{{.PageData.Product.Name}} ({{.PageData.Product.SKU}}){{end}}

{{define "main"}}
<div class="row">
    <div class="col-md-4">
        <div class="box box-primary">
            <div class="box-body box-profile">
                <img class="profile-user-img img-responsive img-circle" src="https://ui-avatars.com/api/?name={{.PageData.Product.Name}}&size=128" alt="Product picture">
                <h3 class="profile-username text-center">{{.PageData.Product.Name}}</h3>
                <p class="text-muted text-center">{{.PageData.Product.SKU}}</p>
                <ul class="list-group list-group-unbordered">
                    <li class="list-group-item">
                        <b>Purchase Price</b> <a class="pull-right">${{.PageData.Product.PurchasePrice}}</a>
                    </li>
                    <li class="list-group-item">
                        <b>Selling Price</b> <a class="pull-right">${{.PageData.Product.SellingPrice}}</a>
                    </li>
                    <li class="list-group-item">
                        <b>Alert Quantity</b> <a class="pull-right">{{.PageData.Product.AlertQuantity}}</a>
                    </li>
                </ul>
                <a href="/products/edit?id={{.PageData.Product.ID}}" class="btn btn-primary btn-block"><b>Edit Product</b></a>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="nav-tabs-custom">
            <ul class="nav nav-tabs">
                <li class="active"><a href="#details" data-toggle="tab">Details</a></li>
                <li><a href="#stock" data-toggle="tab">Stock History</a></li>
            </ul>
            <div class="tab-content">
                <div class="active tab-pane" id="details">
                    <strong><i class="fa fa-file-text-o margin-r-5"></i> Description</strong>
                    <p class="text-muted">
                        {{if .PageData.Product.Description}}{{.PageData.Product.Description}}{{else}}No description provided.{{end}}
                    </p>
                    <hr>
                    <strong><i class="fa fa-calendar margin-r-5"></i> Created At</strong>
                    <p class="text-muted">{{.PageData.Product.CreatedAt.Format "Jan 02, 2006"}}</p>
                </div>
                <div class="tab-pane" id="stock">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Location</th>
                                <th>City</th>
                                <th>Current Stock</th>
                            </tr>
                        </thead>
                        <tbody>
                            {{range .PageData.Stock}}
                            <tr>
                                <td>{{.LocationName}}</td>
                                <td>{{.City}}</td>
                                <td>
                                    <span class="label {{if gt .Qty 0.0}}label-success{{else}}label-danger{{end}}">
                                        {{.Qty}}
                                    </span>
                                </td>
                            </tr>
                            {{end}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{{end}}
