    }

    body.legacy-product-create .product-create-page .input-group-addon {
        display: table-cell;
        width: 1%;
        padding: 6px 12px;
        white-space: nowrap;
        vertical-align: middle;
        background-color: #eee;
        border: 1px solid #ccc;
        color: #555;
    }

    body.legacy-product-create .product-create-page .input-group-btn {
        display: table-cell;
        width: 1%;
        vertical-align: middle;
    }

    body.legacy-product-create .product-create-page .btn {
        border-radius: 3px;
        box-shadow: none;
        height: 34px;
        padding: 6px 12px;
        font-size: 14px;
    }

    body.legacy-product-create .product-create-page .btn-lg {
        height: 46px;
        padding: 10px 16px;
        font-size: 18px;
        line-height: 1.33;
    }

    body.legacy-product-create .product-create-page .btn-default {
        background-color: #f4f4f4;
        border-color: #ddd;
        color: #444;
    }

    body.legacy-product-create .product-create-page .btn-default:hover {
        background-color: #e6e6e6;
        border-color: #adadad;
    }

    body.legacy-product-create .product-create-page .btn-primary {
        background-color: #3c8dbc;
        border-color: #367fa9;
        color: #fff;
    }

    body.legacy-product-create .product-create-page .btn-primary:hover,
    body.legacy-product-create .product-create-page .btn-primary:focus {
        background-color: #367fa9;
        border-color: #204d74;
        color: #fff;
    }

    body.legacy-product-create .product-create-page .btn-success {
        background-color: #00a65a;
        border-color: #008d4c;
