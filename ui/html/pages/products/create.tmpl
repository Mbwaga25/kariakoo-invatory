    body.legacy-product-create .product-create-page .modal-header,
    body.legacy-product-create .product-create-page .modal-body,
    body.legacy-product-create .product-create-page .modal-footer {
        padding: 15px;
    }

    body.legacy-product-create .product-create-page .modal-header {
        border-bottom: 1px solid #e5e5e5;
    }

    body.legacy-product-create .product-create-page .modal-footer {
        border-top: 1px solid #e5e5e5;
        text-align: right;
    }

    body.legacy-product-create .product-create-page .close {
        float: right;
        font-size: 21px;
        font-weight: 700;
        line-height: 1;
        color: #000;
        text-shadow: 0 1px 0 #fff;
        opacity: 0.2;
        background: transparent;
        border: 0;
    }

    body.legacy-product-create .product-create-page .close:hover {
        opacity: 0.5;
    }

    body.legacy-product-create .product-create-page .type-card-inner {
        transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;
