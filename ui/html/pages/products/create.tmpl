    }

    body.legacy-product-create .product-create-page .table > thead > tr > th,
    body.legacy-product-create .product-create-page .table > tbody > tr > td {
        padding: 8px;
        border: 1px solid #ddd;
        border-radius: 0;
    }

    body.legacy-product-create .product-create-page .table > thead > tr > th {
        background: #f9f9f9;
        color: #444;
    }

    body.legacy-product-create .product-create-page .radio {
