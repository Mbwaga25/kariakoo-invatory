{{define "title"}}Add New Product{{end}}

{{define "header"}}Add New Product{{end}}
{{define "subheader"}}Create a new product for your inventory{{end}}

{{define "main"}}
<div class="box box-primary">
    <div class="box-header with-border">
        <h3 class="box-title">Product Details</h3>
    </div>
    
    <form action="/products/store" method="POST">
        <div class="box-body">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="name">Product Name:*</label>
                        <input type="text" name="name" class="form-control" id="name" placeholder="Enter product name" required>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="sku">SKU:</label>
                        <input type="text" name="sku" class="form-control" id="sku" placeholder="Auto-generated if empty">
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="unit_id">Unit:*</label>
                        <div class="input-group">
                            <select name="unit_id" id="unit_id" class="form-control" required>
                                <option value="">Please Select</option>
                                {{range .PageData.Units}}
                                <option value="{{.ID}}">{{.ActualName}}</option>
                                {{end}}
                            </select>
                            <span class="input-group-btn">
                                <button type="button" class="btn btn-default" data-toggle="modal" data-target="#quick_add_unit"><i class="fa fa-plus text-primary"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="category_id">Category:</label>
                        <div class="input-group">
                            <select name="category_id" id="category_id" class="form-control">
                                <option value="">Please Select</option>
                                {{range .PageData.Categories}}
                                <option value="{{.ID}}">{{.Name}}</option>
                                {{end}}
                            </select>
                            <span class="input-group-btn">
                                <button type="button" class="btn btn-default" data-toggle="modal" data-target="#quick_add_category"><i class="fa fa-plus text-primary"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="brand_id">Brand:</label>
                        <div class="input-group">
                            <select name="brand_id" id="brand_id" class="form-control">
                                <option value="">Please Select</option>
                                {{range .PageData.Brands}}
                                <option value="{{.ID}}">{{.Name}}</option>
                                {{end}}
                            </select>
                            <span class="input-group-btn">
                                <button type="button" class="btn btn-default" data-toggle="modal" data-target="#quick_add_brand"><i class="fa fa-plus text-primary"></i></button>
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="purchase_price">Purchase Price:*</label>
                        <div class="input-group">
                            <span class="input-group-addon">$</span>
                            <input type="number" step="0.01" name="purchase_price" class="form-control" id="purchase_price" value="0.00" required>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="margin">Profit Margin (%):*</label>
                        <input type="number" step="0.1" name="margin" class="form-control" id="margin" value="25.0">
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="selling_price">Selling Price:*</label>
                        <div class="input-group">
                            <span class="input-group-addon">$</span>
                            <input type="number" step="0.01" name="selling_price" class="form-control" id="selling_price" value="0.00" required>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <label for="description">Product Description:</label>
                        <textarea name="description" class="form-control" rows="3" placeholder="Enter product description"></textarea>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label for="alert_quantity">Alert Quantity:</label>
                        <input type="number" name="alert_quantity" class="form-control" id="alert_quantity" value="0">
                    </div>
                </div>
            </div>

            <hr>
            <div class="row">
                <div class="col-md-12">
                    <div class="box box-solid box-primary">
                        <div class="box-header with-border">
                            <h3 class="box-title">Inventory & Locations</h3>
                        </div>
                        <div class="box-body">
                            <div class="form-group">
                                <label>Location Assignment:*</label>
                                <div class="radio">
                                    <label>
                                        <input type="radio" name="location_type" id="location_type_all" value="all" checked>
                                        Add to All Locations
                                    </label>
                                </div>
                                <div class="radio">
                                    <label>
                                        <input type="radio" name="location_type" id="location_type_specific" value="specific">
                                        Add to Specific Location(s)
                                    </label>
                                </div>
                            </div>
                            
                            <div id="specific_locations_container" style="display: none;">
                                <table class="table table-bordered table-striped">
                                    <thead>
                                        <tr class="bg-gray">
                                            <th style="width: 50px;">Select</th>
                                            <th>Business Location</th>
                                            <th style="width: 200px;">Opening Stock</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {{range .PageData.Locations}}
                                        <tr>
                                            <td class="text-center">
                                                <input type="checkbox" name="location_ids" value="{{.ID}}" class="location-check">
                                            </td>
                                            <td>
                                                <span class="tw-font-bold">{{.Name}}</span><br>
                                                <small class="text-muted">{{.City}}, {{.Country}}</small>
                                            </td>
                                            <td>
                                                <div class="input-group">
                                                    <input type="number" step="0.01" name="opening_stock_{{.ID}}" class="form-control stock-input" value="0.00">
                                                    <span class="input-group-addon"><i class="fa fa-cubes"></i></span>
                                                </div>
                                            </td>
                                        </tr>
                                        {{end}}
                                    </tbody>
                                </table>
                                <p class="help-block"><i class="fa fa-info-circle"></i> Enable the checkbox and set initial stock levels for specific shop branches.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="box-footer">
            <button type="submit" class="btn btn-primary btn-lg">Save Product</button>
            <a href="/products" class="btn btn-default btn-lg">Cancel</a>
        </div>
    </form>
</div>

<!-- Quick Add Modals -->
<div class="modal fade" id="quick_add_category" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Add Category</h4>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Category Name:*</label>
                    <input type="text" id="new_category_name" class="form-control">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" onclick="quickAdd('category')">Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="quick_add_brand" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Add Brand</h4>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Brand Name:*</label>
                    <input type="text" id="new_brand_name" class="form-control">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" onclick="quickAdd('brand')">Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="quick_add_unit" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Add Unit</h4>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Unit Name:*</label>
                    <input type="text" id="new_unit_name" class="form-control" placeholder="e.g. Pieces">
                </div>
                <div class="form-group">
                    <label>Short Name:*</label>
                    <input type="text" id="new_unit_short" class="form-control" placeholder="e.g. pc">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" onclick="quickAdd('unit')">Save</button>
            </div>
        </div>
    </div>
</div>

{{end}}

{{define "scripts"}}
<script type="text/javascript">
    function quickAdd(type) {
        let name, shortName = "", url = "";
        if (type === 'category') {
            name = document.getElementById('new_category_name').value;
            url = '/api/categories/store';
        } else if (type === 'brand') {
            name = document.getElementById('new_brand_name').value;
            url = '/api/brands/store';
        } else if (type === 'unit') {
            name = document.getElementById('new_unit_name').value;
            shortName = document.getElementById('new_unit_short').value;
            url = '/api/units/store';
        }

        if (!name) return alert("Name is required");

        const data = new URLSearchParams();
        data.append('name', name);
        if (shortName) data.append('short_name', shortName);
        if (type === 'unit') data.append('actual_name', name);

        fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: data
        })
        .then(res => res.json())
        .then(res => {
            if (res.success) {
                const select = document.getElementById(type + '_id');
                const opt = document.createElement('option');
                opt.value = res.id;
                opt.text = name;
                opt.selected = true;
                select.add(opt);
                
                // Close modal
                $('#quick_add_' + type).modal('hide');
                // Reset inputs
                if (type === 'category') document.getElementById('new_category_name').value = '';
                if (type === 'brand') document.getElementById('new_brand_name').value = '';
                if (type === 'unit') {
                    document.getElementById('new_unit_name').value = '';
                    document.getElementById('new_unit_short').value = '';
                }
            } else {
                alert("Error: " + res.message);
            }
        });
    }

    document.addEventListener('DOMContentLoaded', function() {
        const purchaseInput = document.getElementById('purchase_price');
        const marginInput = document.getElementById('margin');
        const sellingInput = document.getElementById('selling_price');

        function calculateSellingPrice() {
            const purchase = parseFloat(purchaseInput.value) || 0;
            const margin = parseFloat(marginInput.value) || 0;
            const selling = purchase + (purchase * (margin / 100));
            sellingInput.value = selling.toFixed(2);
        }

        function calculateMargin() {
            const purchase = parseFloat(purchaseInput.value) || 0;
            const selling = parseFloat(sellingInput.value) || 0;
            if (purchase > 0) {
                const margin = ((selling - purchase) / purchase) * 100;
                marginInput.value = margin.toFixed(1);
            }
        }

        purchaseInput.addEventListener('input', calculateSellingPrice);
        marginInput.addEventListener('input', calculateSellingPrice);
        sellingInput.addEventListener('input', calculateMargin);

        // Location toggle logic
        const locationTypeRadios = document.querySelectorAll('input[name="location_type"]');
        const specificLocationsContainer = document.getElementById('specific_locations_container');
        
        locationTypeRadios.forEach(radio => {
            radio.addEventListener('change', function() {
                if (this.value === 'specific') {
                    specificLocationsContainer.style.display = 'block';
                } else {
                    specificLocationsContainer.style.display = 'none';
                }
            });
        });
    });
</script>
{{end}}
