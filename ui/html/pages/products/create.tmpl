{{define "title"}}Add New Product{{end}}

{{define "bodyClass"}}legacy-product-create{{end}}

{{define "header"}}Add New Product{{end}}
{{define "subheader"}}Register a new Protector or Cover{{end}}

{{define "styles"}}
<style>
