        border-bottom-color: #3c8dbc;
    }

    body.legacy-product-create .product-create-page .box.box-solid.box-primary > .box-header .box-title {
        color: #fff;
    }

    body.legacy-product-create .product-create-page hr {
        margin: 20px 0;
