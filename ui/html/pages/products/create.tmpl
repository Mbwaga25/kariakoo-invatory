    }

    body.legacy-product-create .product-create-page .radio label {
        font-weight: 400;
    }

    body.legacy-product-create .product-create-page .bg-gray {
        color: #000 !important;
        background-color: #d2d6de !important;
    }

    body.legacy-product-create .product-create-page .box.box-solid.box-primary {
