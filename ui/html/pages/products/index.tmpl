{{define "title"}}Products List{{end}}

{{define "header"}}Products{{end}}
{{define "subheader"}}Manage your inventory items{{end}}

{{define "main"}}
<div class="box box-primary">
    <div class="box-header with-border">
        <h3 class="box-title">All Products</h3>
        <div class="box-tools">
            <a href="/products/create" class="btn btn-primary btn-sm">
                <i class="fa fa-plus"></i> Add New Product
            </a>
        </div>
    </div>
    <div class="box-body">
        <div class="filter-section tw-mb-4" style="margin-bottom: 20px; padding: 15px; background: #f9f9f9; border: 1px solid #eee; border-radius: 4px;">
            <form method="GET" action="/products" class="form-inline">
                <div class="form-group">
                    <label for="category_id" style="margin-right: 5px;">Category:</label>
                    <select name="category_id" id="category_id" class="form-control input-sm">
                        <option value="">All Categories</option>
                        {{range .PageData.Categories}}
                        <option value="{{.ID}}" {{if eq $.PageData.Filters.CategoryID .ID}}selected{{end}}>{{.Name}}</option>
                        {{end}}
                    </select>
                </div>
                <div class="form-group" style="margin-left: 15px;">
                    <label for="brand_id" style="margin-right: 5px;">Brand:</label>
                    <select name="brand_id" id="brand_id" class="form-control input-sm">
                        <option value="">All Brands</option>
                        {{range .PageData.Brands}}
                        <option value="{{.ID}}" {{if eq $.PageData.Filters.BrandID .ID}}selected{{end}}>{{.Name}}</option>
                        {{end}}
                    </select>
                </div>
                <div class="form-group" style="margin-left: 15px;">
                    <label for="location_id" style="margin-right: 5px;">Location:</label>
                    <select name="location_id" id="location_id" class="form-control input-sm">
                        <option value="">Current Location (Default)</option>
                        {{range .PageData.Locations}}
                        <option value="{{.ID}}" {{if eq $.PageData.Filters.LocationID .ID}}selected{{end}}>{{.Name}}</option>
                        {{end}}
                    </select>
                </div>
                <button type="submit" class="btn btn-primary btn-sm" style="margin-left: 15px;"><i class="fa fa-filter"></i> Apply Filter</button>
                <a href="/products" class="btn btn-default btn-sm" style="margin-left: 5px;">Clear</a>
            </form>
        </div>
        <div class="table-responsive">
            <table class="table table-bordered table-striped datatable" id="products_table">
                <thead>
                    <tr>
                        <th>SKU</th>
                        <th>Product Name</th>
                        <th>Purchase Price</th>
                        <th>Selling Price</th>
                        <th>Current Stock</th>
                        <th>Alert Qty</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{range .PageData.Products}}
                    <tr>
                        <td>{{.SKU}}</td>
                        <td>{{.Name}}</td>
                        <td>{{$.CurrencySymbol}}{{.PurchasePrice}}</td>
                        <td>{{$.CurrencySymbol}}{{.SellingPrice}}</td>
                        <td>
                            <span class="label {{if gt .LocationQty 0.0}}label-success{{else}}label-danger{{end}}">
                                {{.LocationQty}}
                            </span>
                        </td>
                        <td><span class="label label-warning">{{.AlertQuantity}}</span></td>
                        <td>
                            <a href="/products/view?id={{.ID}}" class="btn btn-xs btn-info"><i class="fa fa-eye"></i> View</a>
                            <a href="/products/edit?id={{.ID}}" class="btn btn-xs btn-primary"><i class="fa fa-edit"></i> Edit</a>
                        </td>
                    </tr>
                    {{end}}
                </tbody>
            </table>
        </div>
    </div>
</div>
{{end}}
