{{define "title"}}Products List{{end}}

{{define "header"}}Products{{end}}
{{define "subheader"}}Manage your inventory items{{end}}

{{define "main"}}
<div class="box box-primary">
    <div class="box-header with-border">
        <h3 class="box-title"><i class="fa fa-cubes"></i> All Products</h3>
        <div class="box-tools">
            <a href="/products/create" class="btn btn-primary btn-sm">
                <i class="fa fa-plus"></i> Add New Product
            </a>
        </div>
    </div>
    <div class="box-body">
        <div class="filter-section" style="margin-bottom: 20px; padding: 15px; background: #f9f9f9; border: 1px solid #eee; border-radius: 8px;">
            <form method="GET" action="/products" class="form-inline">
                <div class="form-group">
                    <label style="margin-right: 5px;">Type:</label>
                    <select name="product_type" class="form-control input-sm">
                        <option value="">All Types</option>
                        <option value="Protector" {{if eq (index .PageData.Filters "ProductType") "Protector"}}selected{{end}}>Protector</option>
                        <option value="Cover" {{if eq (index .PageData.Filters "ProductType") "Cover"}}selected{{end}}>Cover</option>
                    </select>
                </div>
                <div class="form-group" style="margin-left: 15px;">
                    <label style="margin-right: 5px;">Category:</label>
                    <select name="category_id" class="form-control input-sm">
                        <option value="">All Categories</option>
                        {{range .PageData.Categories}}
                        <option value="{{.ID}}">{{.Name}}</option>
                        {{end}}
                    </select>
                </div>
                <div class="form-group" style="margin-left: 15px;">
                    <label style="margin-right: 5px;">Phone Model:</label>
                    <select name="brand_id" class="form-control input-sm">
                        <option value="">All Models</option>
                        {{range .PageData.Brands}}
                        <option value="{{.ID}}">{{.Name}}</option>
                        {{end}}
                    </select>
                </div>
                <div class="form-group" style="margin-left: 15px;">
                    <label style="margin-right: 5px;">Store:</label>
                    <select name="location_id" class="form-control input-sm">
                        <option value="">Current Store</option>
                        {{range .PageData.Locations}}
                        <option value="{{.ID}}">{{.Name}}</option>
                        {{end}}
                    </select>
                </div>
                <button type="submit" class="btn btn-primary btn-sm" style="margin-left: 15px;"><i class="fa fa-filter"></i> Filter</button>
                <a href="/products" class="btn btn-default btn-sm" style="margin-left: 5px;">Clear</a>
            </form>
        </div>
        <div class="table-responsive">
            <table class="table table-bordered table-striped datatable" id="products_table">
                <thead>
                    <tr>
                        <th>Type</th>
                        <th>Category</th>
                        <th>Phone Model</th>
                        <th>Product Name</th>
                        <th>SKU</th>
                        <th>Current Stock</th>
                        <th>Alert Qty</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{range .PageData.Products}}
                    <tr>
                        <td>
                            {{if eq .ProductType "Protector"}}
                            <span class="label" style="background:#2E7D32;"><i class="fa fa-shield-alt"></i> Protector</span>
                            {{else}}
                            <span class="label" style="background:#0277BD;"><i class="fa fa-mobile-alt"></i> Cover</span>
                            {{end}}
                        </td>
                        <td>{{.CategoryName}}</td>
                        <td>{{.BrandName}}</td>
                        <td><strong>{{.Name}}</strong></td>
                        <td><code>{{.SKU}}</code></td>
                        <td>
                            <span class="label {{if gt .LocationQty 0.0}}label-success{{else}}label-danger{{end}}" style="font-size:13px;">
                                {{.LocationQty}}
                            </span>
                        </td>
                        <td>
                            {{if .AlertQuantity}}
                            <span class="label label-warning">{{.AlertQuantity}}</span>
                            {{else}}
                            <span class="text-muted">—</span>
                            {{end}}
                        </td>
                        <td>
                            <a href="/products/view?id={{.ID}}" class="btn btn-xs btn-info" title="View Details"><i class="fa fa-eye"></i></a>
                            {{if or (eq $.Role "StoreKeeper") (eq $.Role "SuperAdmin") (eq $.Role "ShopAdmin")}}
                            <a href="/purchases/create?product_id={{.ID}}" class="btn btn-xs btn-success" title="Add Stock"><i class="fa fa-download"></i></a>
                            {{end}}
                            <a href="/products/edit?id={{.ID}}" class="btn btn-xs btn-primary" title="Edit"><i class="fa fa-edit"></i></a>
                            {{if or (eq $.Role "SuperAdmin") (eq $.Role "ShopAdmin") (eq $.Role "ShopKeeper") (eq $.Role "StoreKeeper")}}
                            <button class="btn btn-xs btn-danger delete_product" data-id="{{.ID}}" title="Delete"><i class="fa fa-trash"></i></button>
                            {{end}}
                        </td>
                    </tr>
                    {{end}}
                </tbody>
            </table>
        </div>
    </div>
</div>
{{end}}

{{define "scripts"}}
<script>
$(document).ready(function() {
    if ($.fn.DataTable) {
        $('#products_table').DataTable({
            "order": [[0, "asc"]],
            "pageLength": 25
        });
    }

    // Handle delete product
    $('.delete_product').on('click', function() {
        var id = $(this).data('id');
        if (confirm("Are you sure you want to delete this product? This action cannot be undone.")) {
            $.post('/api/products/delete', {id: id}, function(res) {
                if (res.success) {
                    toastr.success('Product deleted successfully');
                    setTimeout(function() { window.location.reload(); }, 1000);
                } else {
                    toastr.error('Failed to delete product: ' + res.message);
                }
            }).fail(function() {
                toastr.error('Network error occurred.');
            });
        }
    });
});
</script>
{{end}}
