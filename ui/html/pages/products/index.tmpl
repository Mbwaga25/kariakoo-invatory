{{define "title"}}Products List{{end}}

{{define "bodyClass"}}products-index-page{{end}}

{{define "header"}}Products{{end}}
{{define "subheader"}}Browse, filter, and manage your inventory items{{end}}

{{define "styles"}}
<style>
    body.products-index-page {
        background: #ecf0f5;
    }

    body.products-index-page .products-page .box {
        border-top: 3px solid #3c8dbc;
        border-radius: 0;
        box-shadow: none;
        margin-bottom: 20px;
    }

    body.products-index-page .products-page .box-header.with-border {
        border-bottom: 1px solid #f4f4f4;
    }

    body.products-index-page .products-page .products-toolbar {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    body.products-index-page .products-page .products-summary {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 5px;
        color: #777;
        font-size: 13px;
    }

    body.products-index-page .products-page .products-summary .label {
        font-size: 11px;
    }

    body.products-index-page .products-page .filter-panel {
        background: #f9f9f9;
        border: 1px solid #ddd;
        padding: 15px;
        margin-bottom: 15px;
    }

    body.products-index-page .products-page .filter-panel .form-group {
        margin-bottom: 15px;
    }

    body.products-index-page .products-page .filter-actions {
        margin-top: 5px;
    }

    body.products-index-page .products-page .filter-actions .btn {
        min-width: 110px;
    }

    body.products-index-page .products-page .table > thead > tr > th {
        background: #f9f9f9;
        color: #444;
        white-space: nowrap;
        vertical-align: middle;
    }

    body.products-index-page .products-page .table > tbody > tr > td {
        vertical-align: middle;
    }

    body.products-index-page .products-page .action-buttons .btn {
        width: 32px;
        height: 32px;
        padding: 0;
        line-height: 30px;
        text-align: center;
    }

    body.products-index-page .products-page .action-buttons .btn + .btn {
        margin-left: 4px;
    }

    body.products-index-page .products-page .empty-note {
        padding: 28px 16px;
        color: #777;
        text-align: center;
    }

    body.products-index-page .products-page .empty-note i {
        display: block;
        margin-bottom: 10px;
        color: #3c8dbc;
        font-size: 36px;
    }

    body.products-index-page .products-page .dataTables_wrapper .row {
        margin-left: 0;
        margin-right: 0;
    }

    body.products-index-page .products-page .dataTables_filter input {
        width: 260px;
    }

    body.products-index-page .products-page .dataTables_length select {
        width: auto;
    }

    @media (max-width: 767px) {
        body.products-index-page .products-page .products-toolbar {
            align-items: stretch;
        }

        body.products-index-page .products-page .filter-actions .btn {
            width: 100%;
            margin-bottom: 8px;
        }

        body.products-index-page .products-page .dataTables_filter input {
            width: 100%;
        }
    }
</style>
{{end}}

{{define "main"}}
<div class="products-page">
    <div class="row">
        <div class="col-xs-12">
            <div class="box box-primary">
                <div class="box-header with-border">
                    <div class="products-toolbar">
                        <div>
                            <h3 class="box-title" style="font-size:18px;margin:0;">
                                <i class="fa fa-cubes text-primary"></i> Products List
                            </h3>
                            <div class="products-summary">
                                <span class="label label-primary">{{len .PageData.Products}}</span>
                                <span>
                                    {{len .PageData.Products}}
                                    {{if eq (len .PageData.Products) 1}}product{{else}}products{{end}} available
                                </span>
                            </div>
                        </div>

                        <div>
                            <a href="/products/create" class="btn btn-success btn-sm">
                                <i class="fa fa-plus"></i> Add Product
                            </a>
                        </div>
                    </div>
                </div>

                <div class="box-body">
                    <form method="GET" action="/products">
                        <div class="filter-panel">
                            <div class="row">
                                <div class="col-md-3 col-sm-6">
                                    <div class="form-group">
                                        <label for="product_type">Product Type</label>
                                        <select id="product_type" name="product_type" class="form-control">
                                            <option value="" {{if not (index .PageData.Filters "ProductType")}}selected{{end}}>All Types</option>
                                            <option value="Protector" {{if eq (index .PageData.Filters "ProductType") "Protector"}}selected{{end}}>Protector</option>
                                            <option value="Cover" {{if eq (index .PageData.Filters "ProductType") "Cover"}}selected{{end}}>Cover</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="col-md-3 col-sm-6">
                                    <div class="form-group">
                                        <label for="category_id">Category</label>
                                        <select id="category_id" name="category_id" class="form-control">
                                            <option value="" {{if not (index .PageData.Filters "CategoryID")}}selected{{end}}>All Categories</option>
                                            {{range .PageData.Categories}}
                                            <option value="{{.ID}}" {{if eq (index $.PageData.Filters "CategoryID") .ID}}selected{{end}}>{{.Name}}</option>
                                            {{end}}
                                        </select>
                                    </div>
                                </div>

                                <div class="col-md-3 col-sm-6">
                                    <div class="form-group">
                                        <label for="brand_id">Phone Model</label>
                                        <select id="brand_id" name="brand_id" class="form-control">
                                            <option value="" {{if not (index .PageData.Filters "BrandID")}}selected{{end}}>All Models</option>
                                            {{range .PageData.Brands}}
                                            <option value="{{.ID}}" {{if eq (index $.PageData.Filters "BrandID") .ID}}selected{{end}}>{{.Name}}</option>
                                            {{end}}
                                        </select>
                                    </div>
                                </div>

                                <div class="col-md-3 col-sm-6">
                                    <div class="form-group">
                                        <label for="location_id">Store</label>
                                        <select id="location_id" name="location_id" class="form-control">
                                            <option value="" {{if not (index .PageData.Filters "LocationID")}}selected{{end}}>Current Store</option>
                                            {{range .PageData.Locations}}
                                            <option value="{{.ID}}" {{if eq (index $.PageData.Filters "LocationID") .ID}}selected{{end}}>{{.Name}}</option>
                                            {{end}}
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-12 text-right filter-actions">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fa fa-filter"></i> Filter
                                    </button>
                                    <a href="/products" class="btn btn-default">
                                        <i class="fa fa-undo"></i> Clear
                                    </a>
                                </div>
                            </div>
                        </div>
                    </form>

                    {{if eq (len .PageData.Products) 0}}
                    <div class="callout callout-info" style="margin-bottom:15px;">
                        <h4><i class="fa fa-info-circle"></i> No products found</h4>
                        <p>Try clearing the filters above or create your first product.</p>
                    </div>
                    {{end}}

                    <div class="table-responsive">
                        <table class="table table-bordered table-striped table-hover" id="products_table">
                            <thead>
                                <tr>
                                    <th>Type</th>
                                    <th>Category</th>
                                    <th>Phone Model</th>
                                    <th>Product Name</th>
                                    <th>SKU</th>
                                    <th>Current Stock</th>
                                    <th>Alert Qty</th>
                                    <th class="text-right">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {{range .PageData.Products}}
                                <tr>
                                    <td>
                                        {{if eq .ProductType "Protector"}}
                                        <span class="label label-success">
                                            <i class="fa fa-shield"></i> Protector
                                        </span>
                                        {{else}}
                                        <span class="label label-info">
                                            <i class="fa fa-mobile"></i> Cover
                                        </span>
                                        {{end}}
                                    </td>
                                    <td>{{if .CategoryName}}{{.CategoryName}}{{else}}-{{end}}</td>
                                    <td>{{if .BrandName}}{{.BrandName}}{{else}}-{{end}}</td>
                                    <td><strong>{{.Name}}</strong></td>
                                    <td><code>{{.SKU}}</code></td>
                                    <td>
                                        <span class="label {{if gt .LocationQty 0.0}}label-success{{else}}label-danger{{end}}">
                                            {{.LocationQty}}
                                        </span>
                                    </td>
                                    <td>
                                        {{if .AlertQuantity}}
                                        <span class="label label-warning">{{.AlertQuantity}}</span>
                                        {{else}}
                                        <span class="text-muted">&mdash;</span>
                                        {{end}}
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group">
                                            <button type="button" class="btn btn-default btn-xs dropdown-toggle" data-toggle="dropdown" aria-expanded="false">
                                                <i class="fa fa-ellipsis-v"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-right" role="menu" style="text-align: left;">
                                                <li><a href="/products/view?id={{.ID}}"><i class="fa fa-eye text-info" style="margin-right: 5px;"></i> View Details</a></li>
                                                {{if or (eq $.Role "StoreKeeper") (eq $.Role "SuperAdmin") (eq $.Role "ShopAdmin")}}
                                                <li><a href="/purchases/create?product_id={{.ID}}"><i class="fa fa-plus text-success" style="margin-right: 5px;"></i> Add Stock</a></li>
                                                {{end}}
                                                {{if or (eq $.Role "SuperAdmin") (eq $.Role "ShopAdmin")}}
                                                <li><a href="/products/edit?id={{.ID}}"><i class="fa fa-pencil text-primary" style="margin-right: 5px;"></i> Edit Product</a></li>
                                                <li class="divider"></li>
                                                <li><a href="#" class="delete_product" data-id="{{.ID}}" style="color: #dd4b39;"><i class="fa fa-trash" style="margin-right: 5px;"></i> Delete Product</a></li>
                                                {{end}}
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                                {{end}}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{{end}}

{{define "scripts"}}
<script>
$(document).ready(function() {
    if ($.fn.DataTable && $('#products_table').length > 0) {
        var table = $('#products_table').DataTable({
            order: [[3, "asc"]],
            pageLength: 25,
            autoWidth: false,
            columnDefs: [
                { targets: 7, orderable: false, searchable: false },
                { targets: [0, 5, 6, 7], className: 'text-center' }
            ],
            dom: '<"row"<"col-sm-6"l><"col-sm-6 text-right"f>>rt<"row"<"col-sm-5"i><"col-sm-7"p>>',
            language: {
                search: "",
                searchPlaceholder: "Search products...",
                emptyTable: "No products match the current filters."
            }
        });

        $('.dataTables_filter input')
            .addClass('form-control input-sm')
            .attr('placeholder', 'Search products...');
        $('.dataTables_length select').addClass('form-control input-sm');
    }

    $(document).on('click', '.delete_product', function(e) {
        e.preventDefault();
        var id = $(this).data('id');
        if (confirm('Are you sure you want to delete this product? This action cannot be undone.')) {
            $.post('/api/products/delete', { id: id }, function(res) {
                if (res.success) {
                    toastr.success('Product deleted successfully');
                    setTimeout(function() {
                        window.location.reload();
                    }, 1000);
                } else {
                    toastr.error('Failed to delete product: ' + res.message);
                }
            }).fail(function() {
                toastr.error('Network error occurred.');
            });
        }
    });
});
</script>
{{end}}
