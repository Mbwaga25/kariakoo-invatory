{{define "base"}}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>{{template "title" .}} - Classic Store</title>
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="csrf-token" content="go-csrf-token-placeholder">

    <link rel="stylesheet" href="/static/css/tailwind/app.css">
    <link rel="stylesheet" href="/static/css/vendor.css">
    <link rel="stylesheet" href="/static/css/app.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/2.0.7/css/dataTables.dataTables.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,600,700" rel="stylesheet">

    <style>
        .skin-blue .main-header .navbar {
            background-color: #0B4E9A !important;
        }
        .skin-blue .main-header .logo {
            background-color: #083c76 !important;
        }
        .skin-blue .main-header .logo:hover {
            background-color: #083c76 !important;
        }
        .skin-blue .main-header .navbar .sidebar-toggle:hover {
            background-color: #083c76 !important;
        }
        .main-footer {
            background: #ffffff !important;
            background-color: #ffffff !important;
        }
    </style>
    {{block "styles" .}}{{end}}
</head>
<body class="hold-transition skin-blue sidebar-mini {{block "bodyClass" .}}{{end}}">
    <div class="wrapper">
        <header class="main-header">
            <a href="/" class="logo" style="display:flex;align-items:center;justify-content:center;">
                <span class="logo-mini"><img src="/static/img/logo.png?v=3" style="height:30px;max-width:40px;object-fit:contain;margin:auto;" alt="CS"/></span>
                <span class="logo-lg"><img src="/static/img/logo.png?v=3" style="height:45px;max-width:200px;object-fit:contain;margin:auto;" alt="Classic Store"/></span>
            </a>

            <nav class="navbar navbar-static-top">
                <a href="#" class="sidebar-toggle" role="button" onclick="toggleSidebar(); return false;">
                    <span class="sr-only">Toggle navigation</span>
                </a>

                <div class="navbar-custom-menu">
                    <ul class="nav navbar-nav">
                        {{if gt (len .Locations) 0}}
                        <li class="dropdown">
                            <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                                <i class="fa fa-map-marker-alt"></i>
                                <span class="hidden-xs">
                                    {{$activeName := "Select Location"}}
                                    {{range .Locations}}
                                        {{if eq .ID $.ActiveLocationID}}{{$activeName = .Name}}{{end}}
                                    {{end}}
                                    {{$activeName}}
                                </span>
                                <b class="caret"></b>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-right">
                                <li class="header">Switch Location</li>
                                <li>
                                    <ul class="menu">
                                        {{range .Locations}}
                                        <li>
                                            <a href="/business-location/switch?location_id={{.ID}}">
                                                <i class="fa fa-building text-aqua"></i> {{.Name}}
                                                {{if eq .ID $.ActiveLocationID}}
                                                <i class="fa fa-check text-success pull-right"></i>
                                                {{end}}
                                            </a>
                                        </li>
                                        {{end}}
                                    </ul>
                                </li>
                            </ul>
                        </li>
                        {{end}}

                        <li class="dropdown user user-menu">
                            <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                                <img src="https://ui-avatars.com/api/?name={{.UserName}}&background=random" class="user-image" alt="{{.UserName}}">
                                <span class="hidden-xs">{{.UserName}}</span>
                            </a>
                            <ul class="dropdown-menu">
                                <li class="user-header">
                                    <img src="https://ui-avatars.com/api/?name={{.UserName}}&background=random" class="img-circle" alt="{{.UserName}}">
                                    <p>
                                        {{.UserName}}
                                        <small>{{.Role}}</small>
                                    </p>
                                </li>
                                <li class="user-footer">
                                    <div class="pull-left">
                                        <a href="/users" class="btn btn-default btn-flat">Users</a>
                                    </div>
                                    <div class="pull-right">
                                        <a href="/logout" class="btn btn-default btn-flat">Sign out</a>
                                    </div>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            </nav>
        </header>

        <aside class="main-sidebar">
            <section class="sidebar">
                <div class="user-panel">
                    <div class="pull-left image">
                        <img src="https://ui-avatars.com/api/?name={{.UserName}}&background=random" class="img-circle" alt="{{.UserName}}">
                    </div>
                    <div class="pull-left info">
                        <p>{{.UserName}}</p>
                        <a href="#"><i class="fa fa-circle text-success"></i> {{.Role}}</a>
                    </div>
                </div>

                <ul class="sidebar-menu" data-widget="tree">
                    <li class="header">Main Navigation</li>

                    {{if and (ne .Role "ShopKeeper") (ne .Role "StoreKeeper")}}
                    <li>
                        <a href="/">
                            <i class="fa fa-dashboard"></i> <span>Dashboard</span>
                        </a>
                    </li>
                    {{end}}

                    {{if or (eq .Role "SuperAdmin") (eq .Role "StoreKeeper") (eq .Role "ShopAdmin")}}
                    <li class="treeview" id="grp-products">
                        <a href="#" onclick="toggleGroup('grp-products'); return false;">
                            <i class="fa fa-cubes"></i>
                            <span>Products</span>
                            <span class="pull-right-container">
                                <i class="fa fa-angle-left pull-right"></i>
                            </span>
                        </a>
                        <ul class="treeview-menu">
                            <li><a href="/products"><i class="fa fa-circle-o"></i> List Products</a></li>
                            <li><a href="/products/create"><i class="fa fa-circle-o"></i> Add Product</a></li>
                        </ul>
                    </li>
                    {{end}}

                    {{if and (index .Modules "purchases") (eq .Role "StoreKeeper")}}
                    <li>
                        <a href="/purchases/create">
                            <i class="fa fa-download"></i> <span>Receive New Stock</span>
                        </a>
                    </li>
                    <li>
                        <a href="/purchases">
                            <i class="fa fa-history"></i> <span>Stock History</span>
                        </a>
                    </li>
                    {{end}}

                    {{if and (index .Modules "purchases") (or (eq .Role "SuperAdmin") (eq .Role "ShopAdmin"))}}
                    <li class="treeview" id="grp-purchases">
                        <a href="#" onclick="toggleGroup('grp-purchases'); return false;">
                            <i class="fa fa-shopping-cart"></i>
                            <span>Purchases</span>
                            <span class="pull-right-container">
                                <i class="fa fa-angle-left pull-right"></i>
                            </span>
                        </a>
                        <ul class="treeview-menu">
                            <li><a href="/purchases"><i class="fa fa-circle-o"></i> List Purchases</a></li>
                            <li><a href="/purchases/create"><i class="fa fa-circle-o"></i> Add Purchase</a></li>
                        </ul>
                    </li>
                    {{end}}

                    {{if and (or (index .Modules "stock_transfers") (index .Modules "stock_adjustments")) (or (eq .Role "SuperAdmin") (eq .Role "StoreKeeper") (eq .Role "ShopAdmin"))}}
                    <li class="treeview" id="grp-stock">
                        <a href="#" onclick="toggleGroup('grp-stock'); return false;">
                            <i class="fa fa-exchange-alt"></i>
                            <span>Stock Mgmt</span>
                            <span class="pull-right-container">
                                <i class="fa fa-angle-left pull-right"></i>
                            </span>
                        </a>
                        <ul class="treeview-menu">
                            {{if index .Modules "stock_transfers"}}
                            <li><a href="/stock-transfers"><i class="fa fa-circle-o"></i> Transfers</a></li>
                            {{end}}
                            {{if index .Modules "stock_adjustments"}}
                            <li><a href="/stock-adjustments"><i class="fa fa-circle-o"></i> Adjustments</a></li>
                            {{end}}
                        </ul>
                    </li>
                    {{end}}

                    {{if or (eq .Role "SuperAdmin") (eq .Role "StoreKeeper") (eq .Role "ShopAdmin")}}
                    <li class="treeview" id="grp-contacts">
                        <a href="#" onclick="toggleGroup('grp-contacts'); return false;">
                            <i class="fa fa-address-book"></i>
                            <span>Contacts</span>
                            <span class="pull-right-container">
                                <i class="fa fa-angle-left pull-right"></i>
                            </span>
                        </a>
                        <ul class="treeview-menu">
                            <li><a href="/contacts?type=customer"><i class="fa fa-circle-o"></i> Customers</a></li>
                        </ul>
                    </li>
                    {{end}}

                    {{if and (index .Modules "sales") (or (eq .Role "SuperAdmin") (eq .Role "ShopAdmin"))}}
                    <li class="treeview" id="grp-sell">
                        <a href="#" onclick="toggleGroup('grp-sell'); return false;">
                            <i class="fa fa-arrow-circle-up"></i>
                            <span>Sell</span>
                            <span class="pull-right-container">
                                <i class="fa fa-angle-left pull-right"></i>
                            </span>
                        </a>
                        <ul class="treeview-menu">
                            <li><a href="/sales"><i class="fa fa-circle-o"></i> All Sales</a></li>
                            <li><a href="/pos/create"><i class="fa fa-circle-o"></i> POS Terminal</a></li>
                            <li><a href="/shipments"><i class="fa fa-circle-o"></i> Shipments</a></li>
                            <li><a href="/discount"><i class="fa fa-circle-o"></i> Discounts</a></li>
                            <li><a href="/sell-return"><i class="fa fa-circle-o"></i> Sell Returns</a></li>
                        </ul>
                    </li>
                    {{end}}

                    {{if and (index .Modules "expenses") (or (eq .Role "SuperAdmin") (eq .Role "ShopAdmin"))}}
                    <li class="treeview" id="grp-expenses">
                        <a href="#" onclick="toggleGroup('grp-expenses'); return false;">
                            <i class="fa fa-minus-circle"></i>
                            <span>Expenses</span>
                            <span class="pull-right-container">
                                <i class="fa fa-angle-left pull-right"></i>
                            </span>
                        </a>
                        <ul class="treeview-menu">
                            <li><a href="/expenses"><i class="fa fa-circle-o"></i> List Expenses</a></li>
                            <li><a href="/expenses/create"><i class="fa fa-circle-o"></i> Add Expense</a></li>
                        </ul>
                    </li>
                    {{end}}

                    <li class="header">Logistics Strategy</li>

                    {{if or (index .Modules "store_management") (eq .Role "SuperAdmin") (eq .Role "StoreKeeper") (eq .Role "ShopKeeper") (eq .Role "ShopAdmin")}}
                    <li class="treeview" id="grp-orders">
                        <a href="#" onclick="toggleGroup('grp-orders'); return false;">
                            <i class="fa fa-store"></i>
                            <span>Store Orders</span>
                            <span class="pull-right-container">
                                <i class="fa fa-angle-left pull-right"></i>
                            </span>
                        </a>
                        <ul class="treeview-menu">
                            <li><a href="/orders"><i class="fa fa-circle-o"></i> All Orders</a></li>
                            <li><a href="/orders/create?type=StoreOrder"><i class="fa fa-circle-o"></i> Request Shop Stock</a></li>
                            <li><a href="/orders/create?type=BulkOrder"><i class="fa fa-circle-o"></i> Request Bulk Stock</a></li>
                            {{if or (eq .Role "StoreKeeper") (eq .Role "SuperAdmin") (eq .Role "ShopAdmin")}}
                            <li><a href="/orders/pending"><i class="fa fa-circle-o"></i> Pending Requests</a></li>
                            {{end}}
                        </ul>
                    </li>
                    {{end}}

                    {{if or (index .Modules "reports") (eq .Role "SuperAdmin") (eq .Role "ShopAdmin")}}
                    <li class="treeview" id="grp-reports">
                        <a href="#" onclick="toggleGroup('grp-reports'); return false;">
                            <i class="fa fa-chart-bar"></i>
                            <span>Reports Ledger</span>
                            <span class="pull-right-container">
                                <i class="fa fa-angle-left pull-right"></i>
                            </span>
                        </a>
                        <ul class="treeview-menu">
                            <li><a href="/reports/purchase-sell"><i class="fa fa-circle-o"></i> Purchase &amp; Sell</a></li>
                            <li><a href="/reports/expense"><i class="fa fa-circle-o"></i> Expenses</a></li>
                            <li><a href="/reports/stock"><i class="fa fa-circle-o"></i> Stock Levels</a></li>
                            <li><a href="/reports/stock-history"><i class="fa fa-circle-o"></i> Stock Flow Log</a></li>
                            <li><a href="/reports/register"><i class="fa fa-circle-o"></i> Register Report</a></li>
                        </ul>
                    </li>
                    {{end}}

                    {{if or (eq .Role "SuperAdmin") (eq .Role "ShopAdmin")}}
                    <li class="treeview" id="grp-settings">
                        <a href="#" onclick="toggleGroup('grp-settings'); return false;">
                            <i class="fa fa-cog"></i>
                            <span>Settings</span>
                            <span class="pull-right-container">
                                <i class="fa fa-angle-left pull-right"></i>
                            </span>
                        </a>
                        <ul class="treeview-menu">
                            
                            <li><a href="/users"><i class="fa fa-circle-o"></i> User Accounts</a></li>
                        </ul>
                    </li>
                    {{end}}

                 

                    <li>
                        <a href="/logout">
                            <i class="fa fa-sign-out"></i> <span>Sign Out</span>
                        </a>
                    </li>
                </ul>
            </section>
        </aside>

        <div class="content-wrapper">
            <section class="content-header">
                <h1>
                    {{template "header" .}}
                    <small>{{template "subheader" .}}</small>
                </h1>
                <ol class="breadcrumb hidden-xs">
                    <li><a href="/"><i class="fa fa-dashboard"></i> Home</a></li>
                    <li class="active">{{template "title" .}}</li>
                </ol>
            </section>

            <section class="content">
                <div class="container-fluid">
                    {{template "main" .}}
                </div>
            </section>
        </div>

        <footer class="main-footer">
            <div class="pull-right hidden-xs">
                Version 1.0.0
            </div>
            <strong>Copyright &copy; 2026 <a href="#">Classic Store</a>.</strong>
        </footer>
    </div>

    <script>
        var base_path = "/";
        var APP = {};
        var datepicker_date_format = "mm/dd/yyyy";
        var moment_date_format = "MM/DD/YYYY";
        var moment_time_format = "HH:mm";
        var app_locale = "en";
        var non_utf8_languages = [];
        var __default_datatable_page_entries = "25";
        var __new_notification_count_interval = "60000";

        function toggleGroup(id) {
            var group = document.getElementById(id);
            if (!group) return;

            var isOpen = group.classList.contains('menu-open');
            var allGroups = document.querySelectorAll('.sidebar-menu > li.treeview');
            allGroups.forEach(function(item) {
                if (item.id !== id) {
                    item.classList.remove('menu-open');
                    item.classList.remove('active');
                }
            });

            if (isOpen) {
                group.classList.remove('menu-open');
                group.classList.remove('active');
                return;
            }

            group.classList.add('menu-open');
            group.classList.add('active');
        }

        function toggleSidebar() {
            if (window.innerWidth < 768) {
                document.body.classList.toggle('sidebar-open');
            } else {
                document.body.classList.toggle('sidebar-collapse');
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            var path = window.location.pathname;
            var pathMap = {
                '/products': 'grp-products',
                '/units': 'grp-products',
                '/categories': 'grp-products',
                '/brands': 'grp-products',
                '/variations': 'grp-products',
                '/import-products': 'grp-products',
                '/import-opening-stock': 'grp-products',
                '/warranties': 'grp-products',
                '/purchases': 'grp-purchases',
                '/stock-transfers': 'grp-stock',
                '/stock-adjustments': 'grp-stock',
                '/contacts': 'grp-contacts',
                '/sales': 'grp-sell',
                '/pos': 'grp-sell',
                '/shipments': 'grp-sell',
                '/discount': 'grp-sell',
                '/sell-return': 'grp-sell',
                '/expenses': 'grp-expenses',
                '/orders': 'grp-orders',
                '/reports': 'grp-reports',
                '/business-settings': 'grp-settings',
                '/business-location': 'grp-settings',
                '/settings': 'grp-settings',
                '/users': 'grp-settings',
            };

            Object.keys(pathMap).some(function(route) {
                if (path.indexOf(route) === 0) {
                    var groupId = pathMap[route];
                    var group = document.getElementById(groupId);
                    if (group) {
                        group.classList.add('menu-open');
                    }
                    return true;
                }
                return false;
            });

            document.querySelectorAll('.sidebar-menu a[href]').forEach(function(link) {
                var href = link.getAttribute('href') || '';
                var cleanHref = href.split('?')[0];
                if (cleanHref === path || path.indexOf(cleanHref) === 0 && cleanHref !== '/') {
                    var li = link.closest('li');
                    if (li) li.classList.add('active');
                    var parentTree = link.closest('li.treeview');
                    if (parentTree) parentTree.classList.add('active', 'menu-open');
                }
            });
        });
    </script>

    <script src="/static/js/vendor.js"></script>
    <script type="text/javascript">
        if (typeof moment !== 'undefined') {
            var financial_year = {
                start: moment().startOf('year'),
                end: moment().endOf('year'),
            };
        }
    </script>
    <script src="https://cdn.datatables.net/2.0.7/js/dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
    <script src="/static/js/lang/en.js"></script>
    <script src="/static/js/functions.js"></script>
    <script src="/static/js/common.js"></script>
    <script src="/static/js/app.js"></script>
    {{block "scripts" .}}{{end}}
</body>
</html>
{{end}}
