{{define "auth"}}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
    <meta name="csrf-token" content="go-csrf-token-placeholder">

    <title>{{template "title" .}} - Inventory App</title>

    <!-- CSS -->
    <link href="/static/css/tailwind/app.css" rel="stylesheet">
    <link rel="stylesheet" href="/static/css/vendor.css">
    <link rel="stylesheet" href="/static/css/app.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.css">
    
    <style>
        html {
            background: #ffffff !important;
            background-color: #ffffff !important;
        }
        body.login-page {
            background: #ffffff !important;
            background-color: #ffffff !important;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
        }
        .role-shopadmin { background: linear-gradient(135deg, #0B4E9A, #2E4A6E); color: #fff; padding: 3px 10px; border-radius: 4px; font-size: 11px; font-weight: 600; }
        .role-storekeeper { background: linear-gradient(135deg, #0277BD, #039BE5); color: #fff; padding: 3px 10px; border-radius: 4px; font-size: 11px; font-weight: 600; }
        .role-shopkeeper { background: linear-gradient(135deg, #2E7D32, #43A047); color: #fff; padding: 3px 10px; border-radius: 4px; font-size: 11px; font-weight: 600; }
    </style>
</head>
<body class="hold-transition login-page">
    <div class="container">
        {{template "main" .}}
    </div>

    <!-- Scripts -->
    <script src="/static/js/vendor.js"></script>
    <script src="/static/js/lang/en.js"></script>
    
    <script type="text/javascript">
        var base_path = "/";
        var APP = {};
        var datepicker_date_format = "mm/dd/yyyy";
        var moment_date_format = "MM/DD/YYYY";
        var moment_time_format = "HH:mm";
        var app_locale = "en";
        var non_utf8_languages = [];
        var __default_datatable_page_entries = "25";
        var __new_notification_count_interval = "60000";
        if (typeof moment !== 'undefined') {
            var financial_year = {
                start: moment().startOf('year'),
                end: moment().endOf('year'),
            };
        }
    </script>

    <script src="/static/js/functions.js"></script>
    <script src="/static/js/common.js"></script>
    <script src="/static/js/app.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.1.4/toastr.min.js"></script>
    <script>
        toastr.options = {
            "closeButton": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "timeOut": "3000"
        };
    </script>
    
    {{block "scripts" .}}{{end}}
</body>
</html>
{{end}}
